diff --git a/apps/desktop/electron/region-capture-controller.test.ts b/apps/desktop/electron/region-capture-controller.test.ts
new file mode 100644
index 00000000..9985e02b
--- /dev/null
+++ b/apps/desktop/electron/region-capture-controller.test.ts
@@ -0,0 +1,137 @@
+import { describe, expect, it, vi } from 'vitest'
+
+import { createRegionCaptureController } from './region-capture-controller'
+
+function setup() {
+  const image = {
+    isEmpty: () => false,
+    getSize: () => ({ width: 3000, height: 2000 }),
+    toPNG: () => new Uint8Array([137, 80, 78, 71])
+  }
+
+  const listSources = vi.fn(async () => [{ id: 'screen:7:0', name: 'Screen 2' }])
+  const chooseSource = vi.fn(async () => 'screen:7:0' as string | null)
+  const captureSource = vi.fn(async () => image)
+  const clock = { now: 1000 }
+  const capture = createRegionCaptureController({ listSources, chooseSource, captureSource, now: () => clock.now })
+
+  return { capture, listSources, chooseSource, captureSource, clock, image }
+}
+
+describe('Local screen acquisition', () => {
+  it('does no work at registration and captures only the explicitly chosen source', async () => {
+    const { capture, listSources, chooseSource, captureSource } = setup()
+    expect(listSources).not.toHaveBeenCalled()
+    const result = await capture.capture(7)
+    expect(chooseSource).toHaveBeenCalledWith([{ id: 'screen:7:0', name: 'Screen 2' }], 7, expect.any(AbortSignal))
+    expect(captureSource).toHaveBeenCalledExactlyOnceWith('screen:7:0', 7)
+    expect(result).toEqual({
+      status: 'ok',
+      imageDataUrl: 'data:image/png;base64,iVBORw==',
+      width: 3000,
+      height: 2000,
+      selectionMode: 'image-crop',
+      appContext: { sourceId: 'screen:7:0', sourceName: 'Screen 2' }
+    })
+  })
+
+  it('does not capture on cancellation or an invented source', async () => {
+    const { capture, chooseSource, captureSource } = setup()
+    chooseSource.mockResolvedValueOnce(null)
+    expect(await capture.capture(7)).toEqual({ status: 'cancelled' })
+    chooseSource.mockResolvedValueOnce('other-screen')
+    expect((await capture.capture(7)).status).toBe('cancelled')
+    expect(captureSource).not.toHaveBeenCalled()
+  })
+
+  it('binds cancellation to the owner and blocks concurrent capture requests', async () => {
+    const { capture, chooseSource, captureSource } = setup()
+    let finish!: (id: string) => void
+    chooseSource.mockImplementationOnce(
+      () =>
+        new Promise(resolve => {
+          finish = resolve
+        })
+    )
+    const pending = capture.capture(7)
+    await Promise.resolve()
+    expect((await capture.capture(8)).status).toBe('cancelled')
+    capture.cancel(8)
+    finish('screen:7:0')
+    expect((await pending).status).toBe('ok')
+    expect(captureSource).toHaveBeenCalledTimes(1)
+  })
+
+  it('drops late images after navigation, close or expiration', async () => {
+    for (const invalidation of ['cancel', 'expire'] as const) {
+      const { capture, captureSource, clock, image } = setup()
+      let finish!: (value: typeof image) => void
+      captureSource.mockImplementationOnce(
+        () =>
+          new Promise(resolve => {
+            finish = resolve
+          })
+      )
+      const pending = capture.capture(7)
+      await vi.waitFor(() => expect(captureSource).toHaveBeenCalled())
+
+      if (invalidation === 'cancel') {
+        capture.cancel(7)
+      } else {
+        clock.now += 90_000
+      }
+
+      finish(image)
+      expect(await pending).toEqual({ status: 'cancelled' })
+    }
+  })
+
+  it('never substitutes a different screen when the selected source vanishes', async () => {
+    const { capture, captureSource } = setup()
+    captureSource.mockResolvedValueOnce(null)
+    expect((await capture.capture(7)).status).toBe('unsupported')
+    expect(captureSource).toHaveBeenCalledTimes(1)
+  })
+
+  it('returns only the selected crop and never falls back to the full image after overlay cancellation', async () => {
+    const { listSources, chooseSource, captureSource, image } = setup()
+
+    const cropped = {
+      ...image,
+      getSize: () => ({ width: 100, height: 50 }),
+      toPNG: () => new Uint8Array([137, 80, 78, 71, 1])
+    }
+
+    const selectRegion = vi.fn(
+      async (): Promise<{ status: 'selected'; image: typeof cropped } | { status: 'cancelled' }> => ({
+        status: 'selected',
+        image: cropped
+      })
+    )
+
+    const capture = createRegionCaptureController({ listSources, chooseSource, captureSource, selectRegion })
+    expect(await capture.capture(7)).toMatchObject({
+      status: 'ok',
+      width: 100,
+      height: 50,
+      selectionMode: 'screen-region',
+      region_already_cropped: true
+    })
+    selectRegion.mockResolvedValueOnce({ status: 'cancelled' })
+    expect(await capture.capture(7)).toEqual({ status: 'cancelled' })
+  })
+
+  it('rejects empty or unbounded images and reports permission denial without raw error text', async () => {
+    const { capture, captureSource, image } = setup()
+    captureSource.mockResolvedValueOnce({ ...image, isEmpty: () => true })
+    expect((await capture.capture(7)).status).toBe('unsupported')
+    captureSource.mockResolvedValueOnce({ ...image, getSize: () => ({ width: 100000, height: 100000 }) })
+    expect((await capture.capture(7)).status).toBe('unsupported')
+    captureSource.mockResolvedValueOnce({ ...image, toPNG: () => new Uint8Array(0) })
+    expect((await capture.capture(7)).status).toBe('unsupported')
+    captureSource.mockRejectedValueOnce(new Error('private permission error and arbitrary credentials'))
+    const result = await capture.capture(7)
+    expect(result.status).toBe('denied')
+    expect(JSON.stringify(result)).not.toContain('credentials')
+  })
+})
diff --git a/apps/desktop/electron/region-capture-controller.ts b/apps/desktop/electron/region-capture-controller.ts
new file mode 100644
index 00000000..15d94893
--- /dev/null
+++ b/apps/desktop/electron/region-capture-controller.ts
@@ -0,0 +1,162 @@
+import type { RegionCaptureResult } from './region-capture-types'
+
+export interface RegionCaptureSource {
+  id: string
+  name: string
+  displayId?: string
+}
+
+export interface RegionCaptureImage {
+  isEmpty(): boolean
+  getSize(): { width: number; height: number }
+  toPNG(): Uint8Array
+}
+
+interface RegionCaptureDependencies {
+  listSources(): Promise<RegionCaptureSource[]>
+  chooseSource(sources: RegionCaptureSource[], owner: number, signal: AbortSignal): Promise<string | null>
+  captureSource(id: string, owner: number): Promise<RegionCaptureImage | null>
+  selectRegion?(
+    image: RegionCaptureImage,
+    source: RegionCaptureSource,
+    owner: number,
+    context: { isCurrent(): boolean; expiresAt: number; signal: AbortSignal }
+  ): Promise<{ status: 'selected'; image: RegionCaptureImage } | { status: 'preview' | 'cancelled' }>
+  now?: () => number
+  expiresAfterMs?: number
+}
+
+/** One owner, one modal consent and one image. No autonomous capture loop. */
+export function createRegionCaptureController(deps: RegionCaptureDependencies) {
+  const now = deps.now ?? Date.now
+  const expiresAfterMs = deps.expiresAfterMs ?? 90_000
+  let generation = 0
+  let active: { owner: number; generation: number; expires: number; abort: AbortController } | null = null
+  let busy = false
+
+  return {
+    cancel(owner?: number) {
+      if (active && (owner === undefined || active.owner === owner)) {
+        active.abort.abort()
+        generation += 1
+        active = null
+      }
+    },
+    async capture(owner: number): Promise<RegionCaptureResult> {
+      if (busy) {
+        return { status: 'cancelled', message: 'A screen selection is already open.' }
+      }
+
+      busy = true
+      const token = { owner, generation: ++generation, expires: now() + expiresAfterMs, abort: new AbortController() }
+      const timer = setTimeout(() => token.abort.abort(), expiresAfterMs)
+      active = token
+
+      const current = () =>
+        active === token && generation === token.generation && now() < token.expires && !token.abort.signal.aborted
+
+      try {
+        const sources = await deps.listSources()
+
+        if (!current()) {
+          return { status: 'cancelled' }
+        }
+
+        if (sources.length === 0 || sources.length > 16) {
+          return { status: 'unsupported', message: 'No selectable screen is available.' }
+        }
+
+        const selected = await deps.chooseSource(sources, owner, token.abort.signal)
+
+        if (!current() || selected === null) {
+          return { status: 'cancelled' }
+        }
+
+        const source = sources.find(item => item.id === selected)
+
+        if (!source) {
+          return { status: 'cancelled', message: 'The selected screen is no longer available.' }
+        }
+
+        let image = await deps.captureSource(source.id, owner)
+
+        if (!current()) {
+          return { status: 'cancelled' }
+        }
+
+        if (!image || image.isEmpty()) {
+          return { status: 'unsupported', message: 'The selected screen could not be captured.' }
+        }
+
+        const originalSize = image.getSize()
+
+        if (
+          !Number.isSafeInteger(originalSize.width) ||
+          !Number.isSafeInteger(originalSize.height) ||
+          originalSize.width < 1 ||
+          originalSize.height < 1 ||
+          originalSize.width * originalSize.height > 16_777_216
+        ) {
+          return { status: 'unsupported', message: 'The screen image exceeds the capture limit.' }
+        }
+
+        let isCropped = false
+
+        if (deps.selectRegion) {
+          const region = await deps.selectRegion(image, source, owner, {
+            isCurrent: current,
+            expiresAt: token.expires,
+            signal: token.abort.signal
+          })
+
+          if (!current() || region.status === 'cancelled') {
+            return { status: 'cancelled' }
+          }
+
+          if (region.status === 'selected') {
+            image = region.image
+            isCropped = true
+          }
+        }
+
+        const { width, height } = image.getSize()
+        const bytes = image.toPNG()
+
+        if (
+          image.isEmpty() ||
+          !Number.isSafeInteger(width) ||
+          !Number.isSafeInteger(height) ||
+          width < 1 ||
+          height < 1 ||
+          width * height > 16_777_216 ||
+          bytes.byteLength === 0 ||
+          bytes.byteLength > 16 * 1024 * 1024
+        ) {
+          return { status: 'unsupported', message: 'The screen image exceeds the capture limit.' }
+        }
+
+        return {
+          status: 'ok',
+          imageDataUrl: `data:image/png;base64,${Buffer.from(bytes).toString('base64')}`,
+          width,
+          height,
+          selectionMode: isCropped ? 'screen-region' : 'image-crop',
+          ...(isCropped ? { region_already_cropped: true } : {}),
+          appContext: { sourceName: source.name, sourceId: source.id }
+        }
+      } catch {
+        return current()
+          ? { status: 'denied', message: 'Screen capture was denied or is unavailable.' }
+          : { status: 'cancelled' }
+      } finally {
+        clearTimeout(timer)
+
+        if (active === token) {
+          active = null
+        }
+
+        busy = false
+      }
+    }
+  }
+}
