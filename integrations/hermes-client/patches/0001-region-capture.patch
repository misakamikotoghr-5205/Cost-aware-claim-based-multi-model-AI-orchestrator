@@ -0,0 +1,46 @@
+/** No remote content, application bridge or agent access lives in this one-purpose page. */
+export function regionCaptureOverlayPage(nonce: string): string {
+  return `<!doctype html><html><head><meta charset="utf-8">
+<meta http-equiv="Content-Security-Policy" content="default-src 'none'; img-src data:; style-src 'unsafe-inline'; script-src 'nonce-${nonce}'; connect-src 'none'; base-uri 'none'; form-action 'none'">
+<style>
+html,body{margin:0;width:100%;height:100%;overflow:hidden;background:transparent;cursor:crosshair;font:16px system-ui}
+img{position:fixed;inset:0;width:100%;height:100%;object-fit:fill;pointer-events:none;user-select:none}
+#selection{position:fixed;display:none;border:2px solid Highlight;box-sizing:border-box;background:color-mix(in srgb,Highlight 12%,transparent);pointer-events:none}
+#help{position:fixed;top:16px;left:50%;transform:translateX(-50%);padding:12px 16px;border-radius:8px;background:Canvas;color:CanvasText;cursor:default;user-select:none}
+button{margin-left:16px;font:inherit;cursor:pointer}
+</style></head><body><img id="screen" draggable="false"><div id="selection"></div><div id="help">Drag a region on the screen · Release to select · Esc to cancel<button id="cancel">Cancel</button></div>
+<script nonce="${nonce}">
+(() => {
+  const api = window.regionSelection;
+  let token = null, start = null, busy = false, loaded = false;
+  const box = document.getElementById('selection');
+  const cancel = () => { if(token && !busy) { busy=true; api.cancel(token); } };
+  const clamp = (value, limit) => Math.min(limit, Math.max(0, value));
+  function rectangle(event) {
+    const x=clamp(event.clientX,innerWidth),y=clamp(event.clientY,innerHeight);
+    return {x:Math.min(start.x,x),y:Math.min(start.y,y),width:Math.abs(x-start.x),height:Math.abs(y-start.y)};
+  }
+  document.getElementById('cancel').onclick=cancel;
+  addEventListener('keydown',event=>{if(event.key==='Escape'){event.preventDefault();cancel();}});
+  addEventListener('pointerdown',event=>{
+    if(!token || !loaded || busy || event.button!==0 || event.target.closest('#help')) return;
+    event.preventDefault();start={x:clamp(event.clientX,innerWidth),y:clamp(event.clientY,innerHeight)};
+    document.body.setPointerCapture(event.pointerId);
+    box.style.display='block';
+  });
+  addEventListener('pointermove',event=>{
+    if(!start || busy) return;const rect=rectangle(event);
+    Object.assign(box.style,{left:rect.x+'px',top:rect.y+'px',width:rect.width+'px',height:rect.height+'px'});
+  });
+  addEventListener('pointerup',event=>{
+    if(!start || busy) return;const rect=rectangle(event);start=null;
+    if(rect.width<2 || rect.height<2){box.style.display='none';return;}
+    busy=true;api.select({token,rect,viewport:{width:innerWidth,height:innerHeight}});
+  });
+  addEventListener('pointercancel',()=>{start=null;box.style.display='none';});
+  api.read().then(data=>{
+    if(!data) return;token=data.token;const image=document.getElementById('screen');image.onload=()=>{loaded=true;};image.src=data.imageDataUrl;
+  });
+})();
+</script></body></html>`
+}
diff --git a/apps/desktop/electron/region-capture-overlay.ts b/apps/desktop/electron/region-capture-overlay.ts
new file mode 100644
index 00000000..f5df4927
--- /dev/null
+++ b/apps/desktop/electron/region-capture-overlay.ts
@@ -0,0 +1,191 @@
+import { randomUUID } from 'node:crypto'
+
+import { BrowserWindow, ipcMain } from 'electron'
+import type { IpcMainInvokeEvent, NativeImage, Rectangle, WebContents } from 'electron'
+
+import { mapRegionToBitmap } from './region-capture-geometry'
+import { regionCaptureOverlayPage } from './region-capture-overlay-page'
+
+interface RegionOverlayOptions {
+  image: NativeImage
+  bounds: Rectangle
+  owner: WebContents
+  preloadPath: string
+  context: { isCurrent(): boolean; expiresAt: number; signal: AbortSignal }
+}
+
+/** Exact-placement platforms only. An invalid crop never falls back to the full image. */
+export async function selectNativeScreenRegion({
+  image,
+  bounds,
+  owner,
+  preloadPath,
+  context
+}: RegionOverlayOptions): Promise<{ status: 'selected'; image: NativeImage } | { status: 'preview' | 'cancelled' }> {
+  if (!context.isCurrent() || context.signal.aborted || owner.isDestroyed()) {
+    return { status: 'cancelled' }
+  }
+
+  const bytes = image.toPNG()
+
+  if (bytes.length === 0 || bytes.length > 16 * 1024 * 1024) {
+    return { status: 'cancelled' }
+  }
+
+  const token = randomUUID()
+  const page = 'data:text/html;charset=utf-8,' + encodeURIComponent(regionCaptureOverlayPage(token))
+
+  const win = new BrowserWindow({
+    ...bounds,
+    frame: false,
+    transparent: true,
+    show: false,
+    resizable: false,
+    movable: false,
+    skipTaskbar: true,
+    alwaysOnTop: true,
+    minimizable: false,
+    maximizable: false,
+    fullscreenable: false,
+    backgroundColor: '#00000000',
+    hasShadow: false,
+    webPreferences: {
+      preload: preloadPath,
+      contextIsolation: true,
+      sandbox: true,
+      nodeIntegration: false,
+      devTools: false
+    }
+  })
+
+  const channels = ['read', 'select', 'cancel'].map(name => `hermes:region-capture:overlay:${name}`)
+
+  return await new Promise(resolve => {
+    let done = false
+    let read = false
+
+    const trusted = (event: IpcMainInvokeEvent) =>
+      !done &&
+      context.isCurrent() &&
+      !owner.isDestroyed() &&
+      event.sender === win.webContents &&
+      event.senderFrame === win.webContents.mainFrame &&
+      event.senderFrame.url === page
+
+    const finish = (result: { status: 'selected'; image: NativeImage } | { status: 'preview' | 'cancelled' }) => {
+      if (done) {
+        return
+      }
+
+      done = true
+      clearTimeout(timer)
+      context.signal.removeEventListener('abort', cancel)
+      owner.removeListener('destroyed', cancel)
+      channels.forEach(channel => ipcMain.removeHandler(channel))
+
+      if (!win.isDestroyed()) {
+        win.destroy()
+      }
+
+      resolve(result)
+    }
+
+    const cancel = () => finish({ status: 'cancelled' })
+    const timer = setTimeout(cancel, Math.max(0, context.expiresAt - Date.now()))
+
+    ipcMain.handle(channels[0], event => {
+      if (!trusted(event) || read) {
+        return null
+      }
+
+      read = true
+
+      return { token, imageDataUrl: `data:image/png;base64,${bytes.toString('base64')}` }
+    })
+    ipcMain.handle(channels[1], (event, payload) => {
+      if (!trusted(event) || payload?.token !== token || !read) {
+        return false
+      }
+
+      const content = win.getContentBounds()
+      const viewport = payload?.viewport
+
+      if (
+        !viewport ||
+        viewport.width !== content.width ||
+        viewport.height !== content.height ||
+        ['x', 'y', 'width', 'height'].some(key => Math.abs(content[key] - bounds[key]) > 1)
+      ) {
+        cancel()
+
+        return false
+      }
+
+      const rect = mapRegionToBitmap(payload?.rect, viewport, image.getSize())
+
+      if (!rect) {
+        cancel()
+
+        return false
+      }
+
+      try {
+        const cropped = image.crop(rect)
+
+        if (cropped.isEmpty()) {
+          cancel()
+        } else {
+          finish({ status: 'selected', image: cropped })
+        }
+      } catch {
+        cancel()
+      }
+
+      return true
+    })
+    ipcMain.handle(channels[2], (event, value) => {
+      if (!trusted(event) || value !== token) {
+        return false
+      }
+
+      cancel()
+
+      return true
+    })
+    win.webContents.setWindowOpenHandler(() => ({ action: 'deny' }))
+    win.webContents.on('will-navigate', event => {
+      event.preventDefault()
+      cancel()
+    })
+    win.webContents.once('render-process-gone', cancel)
+    win.once('closed', cancel)
+    context.signal.addEventListener('abort', cancel, { once: true })
+    owner.once('destroyed', cancel)
+    win.once('ready-to-show', () => {
+      if (!context.isCurrent()) {
+        cancel()
+
+        return
+      }
+
+      // Frameless X11/Windows windows may still have an invisible native frame.
+      // Align the content viewport, not the outer window, with the monitor.
+      win.setContentBounds(bounds)
+      const actual = win.getContentBounds()
+
+      // X11 can round an outer frame edge by one DIP. The crop below always
+      // uses the actual content viewport, so no display-scale guess is made.
+      if (['x', 'y', 'width', 'height'].some(key => Math.abs(actual[key] - bounds[key]) > 1)) {
+        finish({ status: 'preview' })
+
+        return
+      }
+
+      win.setAlwaysOnTop(true, 'screen-saver')
+      win.show()
+      win.focus()
+      win.once('blur', cancel)
+    })
+    void win.loadURL(page).catch(cancel)
+  })
+}
