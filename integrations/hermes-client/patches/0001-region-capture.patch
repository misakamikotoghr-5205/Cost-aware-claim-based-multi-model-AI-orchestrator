+++ b/apps/desktop/electron/region-capture-types.ts
@@ -0,0 +1,23 @@
+/** Device-local image acquisition; cropping and intent stay with the consumer. */
+export interface RegionCaptureAppContext {
+  sourceName?: string
+  sourceId?: string
+  appName?: string
+  windowTitle?: string
+}
+
+export type RegionCaptureResult =
+  | {
+      status: 'ok'
+      imageDataUrl: string
+      width: number
+      height: number
+      /** All platforms use a local preview crop, including native Wayland. */
+      selectionMode: 'image-crop'
+      appContext?: RegionCaptureAppContext
+    }
+  | { status: 'cancelled' | 'unsupported' | 'denied'; message?: string }
+
+export interface RegionCaptureApi {
+  capture(): Promise<RegionCaptureResult>
+}
