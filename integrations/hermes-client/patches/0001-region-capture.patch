index 00000000..2e84d80c
--- /dev/null
+++ b/apps/desktop/electron/region-capture.ts
@@ -0,0 +1,234 @@
+import { app, BrowserWindow, desktopCapturer, dialog, ipcMain, screen, systemPreferences } from 'electron'
+import type { IpcMainInvokeEvent } from 'electron'
+
+import { linuxOzoneBackend } from './hud-windowing'
+import { createRegionCaptureController } from './region-capture-controller'
+import { selectNativeScreenRegion } from './region-capture-overlay'
+import type { RegionCaptureResult } from './region-capture-types'
+import { readWindowBelow } from './window-below'
+
+async function snapshotAppContext(win: BrowserWindow) {
+  let timer: ReturnType<typeof setTimeout>
+
+  try {
+    const titles = process.platform !== 'darwin' || systemPreferences.getMediaAccessStatus('screen') === 'granted'
+
+    const result = await Promise.race([
+      readWindowBelow(process.pid, win.getBounds(), titles),
+      new Promise<null>(resolve => {
+        timer = setTimeout(() => resolve(null), 750)
+      })
+    ])
+
+    return result && 'window' in result ? result.window : null
+  } catch {
+    return null
+  } finally {
+    clearTimeout(timer)
+  }
+}
+
+/** Registers only an inert capability: no shortcut, UI, disk image or model call. */
+export function installRegionCapture({
+  rendererUrl,
+  overlayPreloadPath
+}: {
+  rendererUrl: string
+  overlayPreloadPath?: string
+}): () => void {
+  const expected = new URL(rendererUrl)
+  const channel = 'hermes:region-capture:capture'
+  const hiddenOwners = new Set<number>()
+  const sourceDisplays = new Map<string, string>()
+
+  const controller = createRegionCaptureController({
+    async listSources() {
+      // Zero-sized thumbnails enumerate screens without retaining their pixels.
+      // Native Wayland may additionally show the compositor's source chooser.
+      const sources = await desktopCapturer.getSources({
+        types: ['screen'],
+        thumbnailSize: { width: 0, height: 0 },
+        fetchWindowIcons: false
+      })
+
+      sourceDisplays.clear()
+      sources.forEach(source => {
+        if (source.display_id) {
+          sourceDisplays.set(source.id, source.display_id)
+        }
+      })
+
+      return sources.map(source => ({
+        id: source.id,
+        name: source.name,
+        ...(source.display_id ? { displayId: source.display_id } : {})
+      }))
+    },
+    async chooseSource(sources, owner, signal) {
+      const win = BrowserWindow.getAllWindows().find(item => item.webContents.id === owner)
+
+      if (!win || win.isDestroyed()) {
+        return null
+      }
+
+      const result = await dialog.showMessageBox(win, {
+        type: 'question',
+        title: 'Select a screen',
+        message: 'Choose a screen to capture for local region selection.',
+        detail: 'The image stays in this client. Selecting a screen does not send a prompt or run an action.',
+        buttons: ['Cancel', ...sources.map(source => source.name.replace(/\s+/g, ' ').slice(0, 120))],
+        defaultId: 0,
+        cancelId: 0,
+        noLink: true,
+        signal
+      })
+
+      return sources[result.response - 1]?.id ?? null
+    },
+    async captureSource(id, owner) {
+      const win = BrowserWindow.getAllWindows().find(item => item.webContents.id === owner)
+
+      if (win?.isVisible()) {
+        // Expose the document underneath the client before freezing the screen.
+        hiddenOwners.add(owner)
+        win.hide()
+        await new Promise(resolve => setTimeout(resolve, 120))
+      }
+
+      const sources = await desktopCapturer.getSources({
+        types: ['screen'],
+        thumbnailSize: { width: 4096, height: 4096 },
+        fetchWindowIcons: false
+      })
+
+      // A disappearing source never falls back to another screen. This also
+      // respects a portal denial or changed source during the second request.
+      const expectedDisplay = sourceDisplays.get(id)
+
+      return (
+        sources.find(source => source.id === id && (!expectedDisplay || source.display_id === expectedDisplay))
+          ?.thumbnail ?? null
+      )
+    },
+    async selectRegion(image, source, owner, context) {
+      const exactPlacement =
+        process.platform === 'win32' ||
+        (process.platform === 'linux' && linuxOzoneBackend(process.env, process.argv) === 'x11')
+
+      const display = source.displayId
+        ? screen.getAllDisplays().find(item => String(item.id) === source.displayId)
+        : null
+
+      const win = BrowserWindow.getAllWindows().find(item => item.webContents.id === owner)
+
+      if (!exactPlacement || !display || !overlayPreloadPath || !win || win.isDestroyed()) {
+        return { status: 'preview' }
+      }
+
+      return await selectNativeScreenRegion({
+        image: image as Electron.NativeImage,
+        bounds: display.bounds,
+        owner: win.webContents,
+        preloadPath: overlayPreloadPath,
+        context
+      })
+    }
+  })
+
+  const trustedWindow = (event: IpcMainInvokeEvent) => {
+    const win = BrowserWindow.fromWebContents(event.sender)
+
+    if (!win || win.isDestroyed() || event.senderFrame !== event.sender.mainFrame) {
+      return null
+    }
+
+    try {
+      const actual = new URL(event.senderFrame.url)
+
+      return actual.protocol === expected.protocol &&
+        actual.host === expected.host &&
+        actual.pathname === expected.pathname
+        ? win
+        : null
+    } catch {
+      return null
+    }
+  }
+
+  ipcMain.handle(channel, async (event): Promise<RegionCaptureResult> => {
+    const win = trustedWindow(event)
+
+    if (!win) {
+      return { status: 'denied', message: 'Screen capture requires the trusted desktop window.' }
+    }
+
+    const owner = event.sender.id
+    let invalidated = false
+
+    const cancel = () => {
+      invalidated = true
+      controller.cancel(owner)
+    }
+
+    const navigate = (_event: unknown, _url: string, _inPlace: boolean, isMainFrame: boolean) => {
+      if (isMainFrame) {
+        cancel()
+      }
+    }
+
+    event.sender.once('destroyed', cancel)
+    event.sender.on('did-start-navigation', navigate)
+
+    try {
+      // Sample before the source picker/overlay takes focus. The existing
+      // provider skips our own windows and never prompts for title access.
+      const appContext = await snapshotAppContext(win)
+
+      if (invalidated) {
+        return { status: 'cancelled' }
+      }
+
+      const result = await controller.capture(owner)
+      const displayId = result.status === 'ok' ? sourceDisplays.get(result.appContext?.sourceId) : null
+      const display = displayId ? screen.getAllDisplays().find(item => String(item.id) === displayId) : null
+      const target = appContext?.bounds
+
+      // A window sampled on another monitor must not label this screen's crop.
+      if (
+        result.status === 'ok' &&
+        display &&
+        target &&
+        appContext.app &&
+        target.x < display.bounds.x + display.bounds.width &&
+        display.bounds.x < target.x + target.width &&
+        target.y < display.bounds.y + display.bounds.height &&
+        display.bounds.y < target.y + target.height
+      ) {
+        result.appContext = {
+          ...result.appContext,
+          appName: appContext.app.replace(/\s+/g, ' ').slice(0, 128),
+          windowTitle: appContext.title.replace(/\s+/g, ' ').slice(0, 512)
+        }
+      }
+
+      return result
+    } finally {
+      if (hiddenOwners.delete(owner) && !win.isDestroyed()) {
+        win.showInactive()
+      }
+
+      event.sender.removeListener('destroyed', cancel)
+      event.sender.removeListener('did-start-navigation', navigate)
+    }
+  })
+
+  const dispose = () => {
+    controller.cancel()
+    ipcMain.removeHandler(channel)
+    app.removeListener('will-quit', dispose)
+  }
+
+  app.once('will-quit', dispose)
+
+  return dispose
+}
