+import { describe, expect, it } from 'vitest'
+
+import { mapRegionToBitmap } from './region-capture-geometry'
+
+describe('Native screen selection geometry', () => {
+  it('maps viewport DIPs to the actual bitmap instead of assuming display scale factor', () => {
+    expect(
+      mapRegionToBitmap(
+        { x: 100, y: 50, width: 200, height: 150 },
+        { width: 1500, height: 1000 },
+        { width: 3000, height: 2000 }
+      )
+    ).toEqual({ x: 200, y: 100, width: 400, height: 300 })
+    // The same local rectangle applies on a screen at global x=-1500.
+    expect(
+      mapRegionToBitmap(
+        { x: 0, y: 0, width: 1500, height: 1000 },
+        { width: 1500, height: 1000 },
+        { width: 4096, height: 2730 }
+      )
+    ).toEqual({ x: 0, y: 0, width: 4096, height: 2730 })
+  })
+
+  it('rejects invalid, empty, offscreen and non-finite selections rather than returning the full image', () => {
+    const viewport = { width: 1000, height: 800 }
+
+    for (const rect of [
+      null,
+      { x: -1, y: 0, width: 20, height: 20 },
+      { x: 0, y: 0, width: 0, height: 20 },
+      { x: 995, y: 0, width: 20, height: 20 },
+      { x: NaN, y: 0, width: 20, height: 20 },
+      { x: 0, y: Infinity, width: 20, height: 20 }
+    ]) {
+      expect(mapRegionToBitmap(rect, viewport, { width: 2000, height: 1600 })).toBeNull()
+    }
+  })
+})
diff --git a/apps/desktop/electron/region-capture-geometry.ts b/apps/desktop/electron/region-capture-geometry.ts
new file mode 100644
index 00000000..04a5cf46
--- /dev/null
+++ b/apps/desktop/electron/region-capture-geometry.ts
@@ -0,0 +1,50 @@
+export interface RegionRect {
+  x: number
+  y: number
+  width: number
+  height: number
+}
+
+/** Rectangles are viewport-local DIPs; negative monitor origins never enter this mapping. */
+export function mapRegionToBitmap(
+  rect: RegionRect,
+  viewport: { width: number; height: number },
+  image: { width: number; height: number }
+): RegionRect | null {
+  const values = [
+    rect?.x,
+    rect?.y,
+    rect?.width,
+    rect?.height,
+    viewport?.width,
+    viewport?.height,
+    image?.width,
+    image?.height
+  ]
+
+  if (values.some(value => typeof value !== 'number' || !Number.isFinite(value))) {
+    return null
+  }
+
+  if (
+    rect.x < 0 ||
+    rect.y < 0 ||
+    rect.width <= 0 ||
+    rect.height <= 0 ||
+    viewport.width <= 0 ||
+    viewport.height <= 0 ||
+    image.width <= 0 ||
+    image.height <= 0 ||
+    rect.x + rect.width > viewport.width ||
+    rect.y + rect.height > viewport.height
+  ) {
+    return null
+  }
+
+  const x = Math.floor((rect.x * image.width) / viewport.width)
+  const y = Math.floor((rect.y * image.height) / viewport.height)
+  const right = Math.min(image.width, Math.ceil(((rect.x + rect.width) * image.width) / viewport.width))
+  const bottom = Math.min(image.height, Math.ceil(((rect.y + rect.height) * image.height) / viewport.height))
+
+  return right > x && bottom > y ? { x, y, width: right - x, height: bottom - y } : null
+}
diff --git a/apps/desktop/electron/region-capture-native-smoke.ts b/apps/desktop/electron/region-capture-native-smoke.ts
new file mode 100644
index 00000000..8d09cf8f
--- /dev/null
+++ b/apps/desktop/electron/region-capture-native-smoke.ts
@@ -0,0 +1,162 @@
+/** Build with esbuild (electron external), then run under a real X11 display.
+ * Arguments: bundled region-capture-preload.js, optional synthetic proof PNG.
+ * This fixture never captures the user's normal display: use an isolated X server.
+ */
+import assert from 'node:assert/strict'
+import { writeFileSync } from 'node:fs'
+
+import { app, BrowserWindow, desktopCapturer, screen } from 'electron'
+
+import { selectNativeScreenRegion } from './region-capture-overlay'
+
+app.disableHardwareAcceleration()
+app.commandLine.appendSwitch('ozone-platform', 'x11')
+
+async function waitFor(check: () => boolean | Promise<boolean>) {
+  const deadline = Date.now() + 10000
+
+  while (Date.now() < deadline) {
+    if (await Promise.race([check(), new Promise<boolean>(resolve => setTimeout(() => resolve(false), 500))])) {
+      return
+    }
+
+    await new Promise(resolve => setTimeout(resolve, 25))
+  }
+
+  throw new Error('Native overlay did not become ready')
+}
+
+async function main() {
+  const separator = process.argv.indexOf('--')
+  assert(separator >= 0, 'Pass -- followed by the preload path and optional proof PNG')
+  const args = process.argv.slice(separator + 1)
+  await app.whenReady()
+  const display = screen.getPrimaryDisplay()
+  const source = new BrowserWindow({ ...display.bounds, frame: false, webPreferences: { sandbox: true } })
+  await source.loadURL(
+    'data:text/html;charset=utf-8,' +
+      encodeURIComponent(
+        '<html><body style="background:Canvas;color:CanvasText;font:24px system-ui;padding:40px"><h1>Word document — isolated capture fixture</h1><p>Quarterly report. Select this paragraph directly on the screen.</p><table border="1" cellpadding="16"><tr><th>Region</th><th>Revenue</th></tr><tr><td>North</td><td>1200</td></tr><tr><td>South</td><td>1800</td></tr></table></body></html>'
+      )
+  )
+  await new Promise(resolve => setTimeout(resolve, 150))
+
+  const snapshots = await desktopCapturer.getSources({
+    types: ['screen'],
+    thumbnailSize: {
+      width: Math.ceil(display.bounds.width * display.scaleFactor),
+      height: Math.ceil(display.bounds.height * display.scaleFactor)
+    },
+    fetchWindowIcons: false
+  })
+
+  const image = snapshots.find(item => item.display_id === String(display.id))?.thumbnail
+  assert(image && !image.isEmpty(), 'Real X11 desktop capture is required')
+  assert.equal(await source.webContents.executeJavaScript('typeof window.regionSelection'), 'undefined')
+
+  let observedViewport = { width: 0, height: 0 }
+
+  const capture = async (mode: 'drag' | 'escape' | 'invalid' | 'abort' | 'expiry') => {
+    const abort = new AbortController()
+
+    const pending = selectNativeScreenRegion({
+      image,
+      bounds: display.bounds,
+      owner: source.webContents,
+      preloadPath: args[0],
+      context: {
+        isCurrent: () => !abort.signal.aborted,
+        expiresAt: Date.now() + (mode === 'expiry' ? 1500 : 30000),
+        signal: abort.signal
+      }
+    })
+
+    const overlay = BrowserWindow.getAllWindows().find(item => item !== source)!
+    overlay.webContents.on('preload-error', (_event, _path, error) => console.error('overlay preload:', error.message))
+
+    try {
+      await waitFor(
+        async () =>
+          !overlay.isDestroyed() &&
+          overlay.isVisible() &&
+          (await overlay.webContents.executeJavaScript('Boolean(document.getElementById("screen")?.naturalWidth)'))
+      )
+    } catch (error) {
+      console.error(
+        'overlay state',
+        overlay.isDestroyed()
+          ? 'destroyed'
+          : {
+              visible: overlay.isVisible(),
+              bounds: overlay.getBounds(),
+              page: await overlay.webContents.executeJavaScript(
+                'JSON.stringify({bridge:typeof window.regionSelection,state:document.readyState,image:document.getElementById("screen")?.naturalWidth,sourceLength:document.getElementById("screen")?.src.length})'
+              )
+            }
+      )
+      throw error
+    }
+
+    if (mode === 'drag') {
+      observedViewport = await overlay.webContents.executeJavaScript('({width:innerWidth,height:innerHeight})')
+      overlay.webContents.sendInputEvent({ type: 'mouseDown', x: 100, y: 100, button: 'left', clickCount: 1 })
+      overlay.webContents.sendInputEvent({ type: 'mouseMove', x: 400, y: 300, button: 'left' })
+      await new Promise(resolve => setTimeout(resolve, 50))
+
+      if (args[1]) {
+        writeFileSync(args[1], (await overlay.webContents.capturePage()).toPNG())
+      }
+
+      overlay.webContents.sendInputEvent({ type: 'mouseUp', x: 400, y: 300, button: 'left', clickCount: 1 })
+    } else if (mode === 'escape') {
+      overlay.webContents.sendInputEvent({ type: 'keyDown', keyCode: 'Escape' })
+      overlay.webContents.sendInputEvent({ type: 'keyUp', keyCode: 'Escape' })
+    } else if (mode === 'invalid') {
+      void overlay.webContents
+        .executeJavaScript(
+          'window.regionSelection.select({token:document.querySelector("script").nonce,rect:{x:-1,y:0,width:20,height:20},viewport:{width:innerWidth,height:innerHeight}})'
+        )
+        .catch(() => undefined)
+    } else if (mode === 'abort') {
+      abort.abort()
+    }
+
+    return await pending
+  }
+
+  const selected = await capture('drag')
+  assert.equal(selected.status, 'selected')
+
+  if (selected.status !== 'selected') {
+    throw new Error('Drag did not produce a crop')
+  }
+
+  const size = image.getSize()
+  assert.deepEqual(selected.image.getSize(), {
+    width:
+      Math.ceil((400 * size.width) / observedViewport.width) - Math.floor((100 * size.width) / observedViewport.width),
+    height:
+      Math.ceil((300 * size.height) / observedViewport.height) -
+      Math.floor((100 * size.height) / observedViewport.height)
+  })
+
+  for (const mode of ['escape', 'invalid', 'abort', 'expiry'] as const) {
+    assert.equal((await capture(mode)).status, 'cancelled')
+  }
+
+  source.destroy()
+  console.log(
+    JSON.stringify({
+      native: 'x11',
+      scaleFactor: display.scaleFactor,
+      cases: ['real-screen', 'pointer-drag-crop', 'escape', 'strict-invalid-crop', 'abort', 'expiry'],
+      result: 'passed'
+    })
+  )
+  app.exit(0)
+}
+
+void main().catch(error => {
+  console.error(error)
+  app.exit(1)
+})
