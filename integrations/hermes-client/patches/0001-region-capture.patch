--- /dev/null
+++ b/apps/desktop/electron/region-capture.ts
@@ -0,0 +1,113 @@
+import { app, BrowserWindow, desktopCapturer, dialog, ipcMain } from 'electron'
+import type { IpcMainInvokeEvent } from 'electron'
+
+import { createRegionCaptureController } from './region-capture-controller'
+import type { RegionCaptureResult } from './region-capture-types'
+
+/** Registers only an inert capability: no shortcut, UI, disk image or model call. */
+export function installRegionCapture({ rendererUrl }: { rendererUrl: string }): () => void {
+  const expected = new URL(rendererUrl)
+  const channel = 'hermes:region-capture:capture'
+
+  const controller = createRegionCaptureController({
+    async listSources() {
+      // Zero-sized thumbnails enumerate screens without retaining their pixels.
+      // Native Wayland may additionally show the compositor's source chooser.
+      const sources = await desktopCapturer.getSources({
+        types: ['screen'],
+        thumbnailSize: { width: 0, height: 0 },
+        fetchWindowIcons: false
+      })
+
+      return sources.map(source => ({ id: source.id, name: source.name }))
+    },
+    async chooseSource(sources, owner) {
+      const win = BrowserWindow.getAllWindows().find(item => item.webContents.id === owner)
+
+      if (!win || win.isDestroyed()) {
+        return null
+      }
+
+      const result = await dialog.showMessageBox(win, {
+        type: 'question',
+        title: 'Select a screen',
+        message: 'Choose a screen to capture for local region selection.',
+        detail: 'The image stays in this client. Selecting a screen does not send a prompt or run an action.',
+        buttons: ['Cancel', ...sources.map(source => source.name.replace(/\s+/g, ' ').slice(0, 120))],
+        defaultId: 0,
+        cancelId: 0,
+        noLink: true
+      })
+
+      return sources[result.response - 1]?.id ?? null
+    },
+    async captureSource(id) {
+      const sources = await desktopCapturer.getSources({
+        types: ['screen'],
+        thumbnailSize: { width: 4096, height: 4096 },
+        fetchWindowIcons: false
+      })
+
+      // A disappearing source never falls back to another screen. This also
+      // respects a portal denial or changed source during the second request.
+      return sources.find(source => source.id === id)?.thumbnail ?? null
+    }
+  })
+
+  const trustedWindow = (event: IpcMainInvokeEvent) => {
+    const win = BrowserWindow.fromWebContents(event.sender)
+
+    if (!win || win.isDestroyed() || event.senderFrame !== event.sender.mainFrame) {
+      return null
+    }
+
+    try {
+      const actual = new URL(event.senderFrame.url)
+
+      return actual.protocol === expected.protocol &&
+        actual.host === expected.host &&
+        actual.pathname === expected.pathname
+        ? win
+        : null
+    } catch {
+      return null
+    }
+  }
+
+  ipcMain.handle(channel, async (event): Promise<RegionCaptureResult> => {
+    const win = trustedWindow(event)
+
+    if (!win) {
+      return { status: 'denied', message: 'Screen capture requires the trusted desktop window.' }
+    }
+
+    const owner = event.sender.id
+    const cancel = () => controller.cancel(owner)
+
+    const navigate = (_event: unknown, _url: string, _inPlace: boolean, isMainFrame: boolean) => {
+      if (isMainFrame) {
+        cancel()
+      }
+    }
+
+    event.sender.once('destroyed', cancel)
+    event.sender.on('did-start-navigation', navigate)
+
+    try {
+      return await controller.capture(owner)
+    } finally {
+      event.sender.removeListener('destroyed', cancel)
+      event.sender.removeListener('did-start-navigation', navigate)
+    }
+  })
+
+  const dispose = () => {
+    controller.cancel()
+    ipcMain.removeHandler(channel)
+    app.removeListener('will-quit', dispose)
+  }
+
+  app.once('will-quit', dispose)
+
+  return dispose
+}
