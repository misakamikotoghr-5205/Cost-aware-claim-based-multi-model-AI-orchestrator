@@ -0,0 +1,109 @@
+import { describe, expect, it, vi } from 'vitest'
+
+import { createRegionCaptureController } from './region-capture-controller'
+
+function setup() {
+  const image = {
+    isEmpty: () => false,
+    getSize: () => ({ width: 3000, height: 2000 }),
+    toPNG: () => new Uint8Array([137, 80, 78, 71])
+  }
+
+  const listSources = vi.fn(async () => [{ id: 'screen:7:0', name: 'Screen 2' }])
+  const chooseSource = vi.fn(async () => 'screen:7:0' as string | null)
+  const captureSource = vi.fn(async () => image)
+  const clock = { now: 1000 }
+  const capture = createRegionCaptureController({ listSources, chooseSource, captureSource, now: () => clock.now })
+
+  return { capture, listSources, chooseSource, captureSource, clock, image }
+}
+
+describe('Local screen acquisition', () => {
+  it('does no work at registration and captures only the explicitly chosen source', async () => {
+    const { capture, listSources, chooseSource, captureSource } = setup()
+    expect(listSources).not.toHaveBeenCalled()
+    const result = await capture.capture(7)
+    expect(chooseSource).toHaveBeenCalledWith([{ id: 'screen:7:0', name: 'Screen 2' }], 7)
+    expect(captureSource).toHaveBeenCalledExactlyOnceWith('screen:7:0')
+    expect(result).toEqual({
+      status: 'ok',
+      imageDataUrl: 'data:image/png;base64,iVBORw==',
+      width: 3000,
+      height: 2000,
+      selectionMode: 'image-crop',
+      appContext: { sourceId: 'screen:7:0', sourceName: 'Screen 2' }
+    })
+  })
+
+  it('does not capture on cancellation or an invented source', async () => {
+    const { capture, chooseSource, captureSource } = setup()
+    chooseSource.mockResolvedValueOnce(null)
+    expect(await capture.capture(7)).toEqual({ status: 'cancelled' })
+    chooseSource.mockResolvedValueOnce('other-screen')
+    expect((await capture.capture(7)).status).toBe('cancelled')
+    expect(captureSource).not.toHaveBeenCalled()
+  })
+
+  it('binds cancellation to the owner and blocks concurrent capture requests', async () => {
+    const { capture, chooseSource, captureSource } = setup()
+    let finish!: (id: string) => void
+    chooseSource.mockImplementationOnce(
+      () =>
+        new Promise(resolve => {
+          finish = resolve
+        })
+    )
+    const pending = capture.capture(7)
+    await Promise.resolve()
+    expect((await capture.capture(8)).status).toBe('cancelled')
+    capture.cancel(8)
+    finish('screen:7:0')
+    expect((await pending).status).toBe('ok')
+    expect(captureSource).toHaveBeenCalledTimes(1)
+  })
+
+  it('drops late images after navigation, close or expiration', async () => {
+    for (const invalidation of ['cancel', 'expire'] as const) {
+      const { capture, captureSource, clock, image } = setup()
+      let finish!: (value: typeof image) => void
+      captureSource.mockImplementationOnce(
+        () =>
+          new Promise(resolve => {
+            finish = resolve
+          })
+      )
+      const pending = capture.capture(7)
+      await vi.waitFor(() => expect(captureSource).toHaveBeenCalled())
+
+      if (invalidation === 'cancel') {
+        capture.cancel(7)
+      } else {
+        clock.now += 90_000
+      }
+
+      finish(image)
+      expect(await pending).toEqual({ status: 'cancelled' })
+    }
+  })
+
+  it('never substitutes a different screen when the selected source vanishes', async () => {
+    const { capture, captureSource } = setup()
+    captureSource.mockResolvedValueOnce(null)
+    expect((await capture.capture(7)).status).toBe('unsupported')
+    expect(captureSource).toHaveBeenCalledTimes(1)
+  })
+
+  it('rejects empty or unbounded images and reports permission denial without raw error text', async () => {
+    const { capture, captureSource, image } = setup()
+    captureSource.mockResolvedValueOnce({ ...image, isEmpty: () => true })
+    expect((await capture.capture(7)).status).toBe('unsupported')
+    captureSource.mockResolvedValueOnce({ ...image, getSize: () => ({ width: 100000, height: 100000 }) })
+    expect((await capture.capture(7)).status).toBe('unsupported')
+    captureSource.mockResolvedValueOnce({ ...image, toPNG: () => new Uint8Array(0) })
+    expect((await capture.capture(7)).status).toBe('unsupported')
+    captureSource.mockRejectedValueOnce(new Error('private permission error and arbitrary credentials'))
+    const result = await capture.capture(7)
+    expect(result.status).toBe('denied')
+    expect(JSON.stringify(result)).not.toContain('credentials')
+  })
+})
