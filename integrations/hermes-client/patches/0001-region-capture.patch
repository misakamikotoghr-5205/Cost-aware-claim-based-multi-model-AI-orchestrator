+import { EventEmitter } from 'node:events'
+
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+const native = vi.hoisted(() => ({
+  handlers: new Map<string, (...args: unknown[]) => Promise<unknown>>(),
+  appOnce: vi.fn(),
+  appRemove: vi.fn(),
+  getSources: vi.fn(),
+  showMessageBox: vi.fn(),
+  fromWebContents: vi.fn(),
+  getAllWindows: vi.fn()
+}))
+
+vi.mock('electron', () => ({
+  app: { once: native.appOnce, removeListener: native.appRemove },
+  BrowserWindow: { fromWebContents: native.fromWebContents, getAllWindows: native.getAllWindows },
+  desktopCapturer: { getSources: native.getSources },
+  dialog: { showMessageBox: native.showMessageBox },
+  ipcMain: {
+    handle: (channel: string, handler: (...args: unknown[]) => Promise<unknown>) =>
+      native.handlers.set(channel, handler),
+    removeHandler: (channel: string) => native.handlers.delete(channel)
+  }
+}))
+
+import { installRegionCapture } from './region-capture'
+
+const channel = 'hermes:region-capture:capture'
+
+const image = {
+  isEmpty: () => false,
+  getSize: () => ({ width: 2000, height: 1000 }),
+  toPNG: () => new Uint8Array([137, 80, 78, 71])
+}
+
+function setup() {
+  const contents = Object.assign(new EventEmitter(), {
+    id: 42,
+    mainFrame: { url: 'file:///app/index.html?profile=work' }
+  })
+
+  const win = { webContents: contents, isDestroyed: () => false }
+  native.fromWebContents.mockImplementation(sender => (sender === contents ? win : null))
+  native.getAllWindows.mockReturnValue([win])
+  native.getSources.mockImplementation(async options =>
+    options.thumbnailSize.width === 0
+      ? [{ id: 'screen:1:0', name: 'Screen 1' }]
+      : [{ id: 'screen:1:0', name: 'Screen 1', thumbnail: image }]
+  )
+  native.showMessageBox.mockResolvedValue({ response: 1 })
+  const dispose = installRegionCapture({ rendererUrl: 'file:///app/index.html' })
+  const invoke = native.handlers.get(channel)!
+
+  return { contents, dispose, event: { sender: contents, senderFrame: contents.mainFrame }, invoke }
+}
+
+beforeEach(() => {
+  vi.clearAllMocks()
+  native.handlers.clear()
+})
+
+afterEach(() => {
+  native.handlers.clear()
+})
+
+describe('Region capture native boundary', () => {
+  it('is inert without a consumer and takes pixels only after the native source choice', async () => {
+    const { invoke, event, dispose } = setup()
+    expect(native.getSources).not.toHaveBeenCalled()
+    expect(native.showMessageBox).not.toHaveBeenCalled()
+    const result = await invoke(event)
+    expect(result).toMatchObject({ status: 'ok', width: 2000, height: 1000, selectionMode: 'image-crop' })
+    expect(native.getSources.mock.calls.map(([options]) => options.thumbnailSize.width)).toEqual([0, 4096])
+    expect(native.getSources.mock.invocationCallOrder[1]).toBeGreaterThan(
+      native.showMessageBox.mock.invocationCallOrder[0]
+    )
+    dispose()
+    expect(native.handlers.has(channel)).toBe(false)
+  })
+
+  it('denies subframes and foreign origins before enumerating screens', async () => {
+    const { invoke, event, dispose } = setup()
+    expect(await invoke({ ...event, senderFrame: { url: event.senderFrame.url } })).toMatchObject({ status: 'denied' })
+    event.senderFrame.url = 'https://example.com/index.html'
+    expect(await invoke(event)).toMatchObject({ status: 'denied' })
+    expect(native.getSources).not.toHaveBeenCalled()
+    dispose()
+  })
+
+  it('returns cancelled without acquiring screen pixels when the chooser is cancelled', async () => {
+    const { invoke, event, dispose } = setup()
+    native.showMessageBox.mockResolvedValueOnce({ response: 0 })
+    expect(await invoke(event)).toEqual({ status: 'cancelled' })
+    expect(native.getSources).toHaveBeenCalledTimes(1)
+    dispose()
+  })
+
+  it('does not deliver a late image after the owner navigates', async () => {
+    const { invoke, event, contents, dispose } = setup()
+    let finish!: (sources: unknown[]) => void
+    native.getSources.mockResolvedValueOnce([{ id: 'screen:1:0', name: 'Screen 1' }])
+    native.getSources.mockImplementationOnce(
+      () =>
+        new Promise(resolve => {
+          finish = resolve
+        })
+    )
+    const pending = invoke(event)
+    await vi.waitFor(() => expect(native.getSources).toHaveBeenCalledTimes(2))
+    contents.emit('did-start-navigation', {}, 'file:///app/index.html', false, true)
+    finish([{ id: 'screen:1:0', name: 'Screen 1', thumbnail: image }])
+    expect(await pending).toEqual({ status: 'cancelled' })
+    expect(contents.listenerCount('destroyed')).toBe(0)
+    expect(contents.listenerCount('did-start-navigation')).toBe(0)
+    dispose()
+  })
+
+  it('never exports another screen when the originally chosen source disappears', async () => {
+    const { invoke, event, dispose } = setup()
+    native.getSources.mockResolvedValueOnce([{ id: 'screen:1:0', name: 'Screen 1' }])
+    native.getSources.mockResolvedValueOnce([{ id: 'screen:2:0', name: 'Screen 2', thumbnail: image }])
+    expect(await invoke(event)).toMatchObject({ status: 'unsupported' })
+    dispose()
+  })
+})
