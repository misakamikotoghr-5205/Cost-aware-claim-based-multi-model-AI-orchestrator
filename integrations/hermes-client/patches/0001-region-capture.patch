+import { contextBridge, ipcRenderer } from 'electron'
+
+/** No filesystem, arbitrary IPC, app bridge or capture capability in the overlay. */
+contextBridge.exposeInMainWorld('regionSelection', {
+  read: () => ipcRenderer.invoke('hermes:region-capture:overlay:read'),
+  select: payload => ipcRenderer.invoke('hermes:region-capture:overlay:select', payload),
+  cancel: token => ipcRenderer.invoke('hermes:region-capture:overlay:cancel', token)
+})
