+import { spawn } from 'node:child_process'
+import { EventEmitter, once } from 'node:events'
+import { PassThrough } from 'node:stream'
+
+import { describe, expect, it } from 'vitest'
+
+import { createWindowEnumerationClient, type MetadataChild } from './window-enumeration-client'
+import { metadataLine, WINDOW_METADATA_MAX_BYTES } from './window-enumeration-protocol'
+
+const row = {
+  app: 'Microsoft Word',
+  title: 'Real transport fixture',
+  id: 10,
+  pid: 20,
+  bounds: { x: 0, y: 0, width: 800, height: 600 }
+}
+
+describe('actual metadata child lifecycle', () => {
+  it('accepts a bounded child result and reaps the actual process', async () => {
+    let exited: Promise<unknown[]> = Promise.resolve([])
+
+    const client = createWindowEnumerationClient(() => {
+      const child = spawn(
+        process.execPath,
+        ['-e', `process.stdout.write(${JSON.stringify(metadataLine([row]))});setInterval(()=>{},1000)`],
+        { stdio: ['ignore', 'pipe', 'ignore'] }
+      )
+
+      exited = once(child, 'exit')
+
+      return child
+    })
+
+    expect(await client.read('fixture', { timeoutMs: 1500 })).toEqual([row])
+    await exited
+    expect(client.activeCount).toBe(0)
+  })
+
+  it('a synchronous infinite native-equivalent loop cannot block the parent timeout; real child exits', async () => {
+    let exited: Promise<unknown[]> = Promise.resolve([])
+    let entered: Promise<unknown[]> = Promise.resolve([])
+
+    const client = createWindowEnumerationClient(() => {
+      const child = spawn(process.execPath, ['-e', 'process.stderr.write("entered");while(true){}'], {
+        stdio: ['ignore', 'pipe', 'pipe']
+      })
+
+      exited = once(child, 'exit')
+      entered = once(child.stderr!, 'data')
+
+      return child
+    })
+
+    const result = client.read('blocked', { timeoutMs: 1000 })
+    await entered
+    expect(await result).toHaveProperty('reason', 'window metadata enumeration timed out')
+    await exited
+    expect(client.activeCount).toBe(0)
+  })
+
+  it('owner cancellation terminates an actual blocked child instead of only abandoning its promise', async () => {
+    const abort = new AbortController()
+
+    let exited: Promise<unknown[]> = Promise.resolve([]),
+      entered: Promise<unknown[]> = Promise.resolve([])
+
+    const client = createWindowEnumerationClient(() => {
+      const child = spawn(process.execPath, ['-e', 'process.stderr.write("entered");while(true){}'], {
+        stdio: ['ignore', 'pipe', 'pipe']
+      })
+
+      exited = once(child, 'exit')
+      entered = once(child.stderr!, 'data')
+
+      return child
+    })
+
+    const result = client.read('blocked', { signal: abort.signal, timeoutMs: 2000 })
+    await entered
+    abort.abort()
+    expect(await result).toHaveProperty('reason', 'window metadata enumeration was cancelled')
+    await exited
+    expect(client.activeCount).toBe(0)
+  })
+
+  it('limits HUD/tool/capture concurrency and kills every owned process on quit', async () => {
+    const exits: Promise<unknown[]>[] = []
+    let spawned = 0
+
+    const client = createWindowEnumerationClient(() => {
+      spawned += 1
+      const child = spawn(process.execPath, ['-e', 'while(true){}'], { stdio: ['ignore', 'pipe', 'ignore'] })
+      exits.push(once(child, 'exit'))
+
+      return child
+    })
+
+    const first = client.read('one'),
+      second = client.read('two')
+
+    expect(await client.read('three')).toHaveProperty('reason', expect.stringContaining('busy'))
+    expect(spawned).toBe(2)
+    client.stopAll()
+    await Promise.all([first, second, ...exits])
+    expect(client.activeCount).toBe(0)
+  })
+
+  it('kills a late OS spawn after cancellation and ignores stale output', async () => {
+    class DeferredChild extends EventEmitter implements MetadataChild {
+      stdout = new PassThrough()
+      kills = 0
+      kill() {
+        this.kills += 1
+
+        return true
+      }
+    }
+
+    const child = new DeferredChild(),
+      abort = new AbortController()
+
+    const client = createWindowEnumerationClient(() => child)
+    const result = client.read('late', { signal: abort.signal })
+    abort.abort()
+    await result
+    child.emit('spawn')
+    child.stdout.write(metadataLine([row]))
+    expect(child.kills).toBeGreaterThanOrEqual(2)
+    child.emit('exit', 1)
+    expect(client.activeCount).toBe(0)
+  })
+
+
+  it('drains a utility stdout packet even when process exit is delivered first', async () => {
+    class ExitedChild extends EventEmitter implements MetadataChild {
+      stdout = new PassThrough()
+      kill() { return true }
+    }
+    const child = new ExitedChild()
+    const client = createWindowEnumerationClient(() => child)
+    const result = client.read('already-exited')
+    child.emit('exit', 0)
+    child.stdout.end(metadataLine([row]))
+    expect(await result).toEqual([row])
+    expect(client.activeCount).toBe(0)
+  })
+
+  it('rejects excess output and kills its actual child', async () => {
+    let exited: Promise<unknown[]> = Promise.resolve([])
+
+    const client = createWindowEnumerationClient(() => {
+      const child = spawn(
+        process.execPath,
+        ['-e', `process.stdout.write('x'.repeat(${WINDOW_METADATA_MAX_BYTES + 1}));setInterval(()=>{},1000)`],
+        { stdio: ['ignore', 'pipe', 'ignore'] }
+      )
+
+      exited = once(child, 'exit')
+
+      return child
+    })
+
+    expect(await client.read('too-large', { timeoutMs: 1500 })).toHaveProperty(
+      'reason',
+      'the window metadata helper exceeded its output limit'
+    )
+    await exited
+    expect(client.activeCount).toBe(0)
+  })
+})
diff --git a/apps/desktop/electron/window-enumeration-client.ts b/apps/desktop/electron/window-enumeration-client.ts
new file mode 100644
index 00000000..bff8e2d2
--- /dev/null
+++ b/apps/desktop/electron/window-enumeration-client.ts
@@ -0,0 +1,131 @@
+import type { EnumeratedWindow, EnumerationFailure } from './window-below'
+import { parseMetadataLine, WINDOW_METADATA_MAX_BYTES } from './window-enumeration-protocol'
+
+export interface MetadataChild {
+  stdout: Pick<NodeJS.ReadableStream, 'on'> | null
+  kill(): boolean
+  on(event: string, listener: (...args: any[]) => void): unknown
+}
+
+/** The native DLL can block synchronously forever. A Promise.race on the main
+ * thread cannot interrupt it; a real owned process must be terminated. */
+export function createWindowEnumerationClient(spawn: (modulePath: string) => MetadataChild) {
+  const active = new Set<{ stop: () => void }>()
+
+  return {
+    get activeCount() {
+      return active.size
+    },
+    // before-quit can be declined by the native quit guard. Cancel existing
+    // work without permanently disabling metadata if the person stays.
+    stopAll() {
+      for (const item of active) {item.stop()}
+    },
+    read(
+      modulePath: string,
+      { signal, timeoutMs = 750 }: { signal?: AbortSignal; timeoutMs?: number } = {}
+    ): Promise<EnumeratedWindow[] | EnumerationFailure> {
+      if (signal?.aborted) {return Promise.resolve({ reason: 'window metadata enumeration was cancelled' })}
+
+      // HUD polling, tools and capture share this strict bound. Each permitted
+      // request still samples at its own requested time; no stale cache reuse.
+      if (active.size >= 2)
+        {return Promise.resolve({
+          reason: 'window metadata enumeration is busy; retry when the current sample finishes'
+        })}
+
+      return new Promise(resolve => {
+        let child: MetadataChild | undefined
+        let settled = false
+        let buffers: Buffer[] = []
+        let size = 0
+
+        const terminate = () => {
+          try {
+            child?.kill()
+          } catch {
+            /* owned utility already exited */
+          }
+        }
+
+        const finish = (result: EnumeratedWindow[] | EnumerationFailure) => {
+          if (settled) {return}
+          settled = true
+          clearTimeout(timer)
+          signal?.removeEventListener('abort', abort)
+          buffers = []
+          terminate()
+          resolve(result)
+        }
+
+        const abort = () => finish({ reason: 'window metadata enumeration was cancelled' })
+
+        const slot = {
+          stop: () => {
+            if (settled) {terminate()}
+            else {abort()}
+          }
+        }
+
+        active.add(slot)
+
+        const timer = setTimeout(
+          () => finish({ reason: 'window metadata enumeration timed out' }),
+          Math.max(25, Math.min(3000, timeoutMs))
+        )
+
+        signal?.addEventListener('abort', abort, { once: true })
+
+        try {
+          child = spawn(modulePath)
+          // An abort can beat the OS spawn. Keep this listener until exit so
+          // a late-created process is killed instead of becoming an orphan.
+          child.on('spawn', () => {
+            if (settled) {terminate()}
+          })
+          child.on('error', () => finish({ reason: 'the window metadata utility process failed' }))
+          child.on('exit', () => {
+            active.delete(slot)
+
+            // UtilityProcess can emit exit before the last stdout data/end
+            // event. Retain the bounded pipe until it drains or the deadline.
+            if (!child?.stdout) {finish({ reason: 'the window metadata helper exited without a response' })}
+          })
+
+          if (settled) {terminate()}
+
+          if (!child.stdout) {
+            finish({ reason: 'the window metadata helper has no bounded output pipe' })
+
+            return
+          }
+
+          child.stdout.on('end', () =>
+            finish({ reason: 'the window metadata helper exited without a response' })
+          )
+          child.stdout.on('error', () =>
+            finish({ reason: 'the window metadata helper output pipe failed' })
+          )
+          child.stdout.on('data', chunk => {
+            if (settled) {return}
+            const bytes = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk)
+            size += bytes.length
+
+            if (size > WINDOW_METADATA_MAX_BYTES) {
+              finish({ reason: 'the window metadata helper exceeded its output limit' })
+
+              return
+            }
+
+            buffers.push(bytes)
+
+            if (bytes.includes(10)) {finish(parseMetadataLine(Buffer.concat(buffers).toString('utf8')))}
+          })
+        } catch {
+          active.delete(slot)
+          finish({ reason: 'the window metadata utility process could not be started' })
+        }
+      })
+    }
+  }
+}
