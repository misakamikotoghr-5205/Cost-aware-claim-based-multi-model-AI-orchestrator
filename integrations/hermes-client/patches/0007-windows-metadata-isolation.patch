+import { describe, expect, it } from 'vitest'
+
+import { pickWindowBelow } from './window-below'
+import {
+  metadataLine,
+  parseMetadataLine,
+  projectWindowMetadata,
+  WINDOW_METADATA_MAX_BYTES
+} from './window-enumeration-protocol'
+
+describe('bounded real window metadata transport', () => {
+  it('retains real app/title/bounds and z-order for Word and Excel context', () => {
+    const raw = [
+      {
+        id: 1,
+        owner: { name: 'MISAKA AGENT', processId: 7 },
+        title: '智能指针',
+        bounds: { x: 10, y: 10, width: 360, height: 180 }
+      },
+      {
+        id: 2,
+        owner: { name: 'Microsoft Word', processId: 8 },
+        title: 'Report.docx — Word',
+        bounds: { x: -20, y: 0, width: 900, height: 700 },
+        ignored_private_field: 'must not copy'
+      },
+      {
+        id: 3,
+        owner: { name: 'Microsoft Excel', processId: 9 },
+        title: 'Sales.xlsx — Excel',
+        bounds: { x: 0, y: 0, width: 1000, height: 700 }
+      }
+    ]
+
+    const windows = parseMetadataLine(metadataLine(projectWindowMetadata(raw)))
+    expect(Array.isArray(windows)).toBe(true)
+
+    if (!Array.isArray(windows)) {throw new Error('metadata missing')}
+    expect(pickWindowBelow(windows, 7, raw[0].bounds).below?.app).toBe('Microsoft Word')
+    expect(windows[2].title).toBe('Sales.xlsx — Excel')
+    expect(JSON.stringify(windows)).not.toContain('ignored_private_field')
+    expect(windows[1].bounds.x).toBe(-20)
+  })
+
+  it('bounds window count, all fields and serialized UTF8 bytes without reordering', () => {
+    const raw = Array.from({ length: 500 }, (_, id) => ({
+      id,
+      owner: { name: '字'.repeat(500), processId: id },
+      title: '标题'.repeat(1000),
+      bounds: { x: Infinity, y: NaN, width: -20, height: 300 }
+    }))
+
+    const line = metadataLine(projectWindowMetadata(raw))
+    expect(Buffer.byteLength(line)).toBeLessThanOrEqual(WINDOW_METADATA_MAX_BYTES)
+    const rows = parseMetadataLine(line)
+
+    if (!Array.isArray(rows)) {throw new Error('bounded list missing')}
+    expect(rows.length).toBeLessThanOrEqual(128)
+    expect(rows[0].id).toBe(0)
+    expect(rows[0].app.length).toBe(128)
+    expect(rows[0].title.length).toBe(512)
+    expect(rows[0].bounds).toEqual({ x: 0, y: 0, width: 0, height: 300 })
+  })
+
+  it('rejects unknown fields, malformed rows and unbounded helper output', () => {
+    for (const value of [
+      { version: 1, windows: [], token: 'untrusted' },
+      {
+        version: 1,
+        windows: [{ app: 'Word', title: 'x', id: 1, pid: 2, bounds: { x: 0, y: 0, width: 4, height: -1 } }]
+      },
+      { version: 1, windows: [], error: 'ambiguous' },
+      { version: 2, windows: [] }
+    ])
+      {expect(parseMetadataLine(JSON.stringify(value))).toHaveProperty('reason')}
+
+    expect(parseMetadataLine('x'.repeat(WINDOW_METADATA_MAX_BYTES + 1))).toHaveProperty('reason')
+    expect(projectWindowMetadata(undefined)).toHaveProperty('reason')
+    expect(parseMetadataLine(metadataLine([]))).toEqual([])
+  })
+})
diff --git a/apps/desktop/electron/window-enumeration-protocol.ts b/apps/desktop/electron/window-enumeration-protocol.ts
new file mode 100644
index 00000000..4c386d2a
--- /dev/null
+++ b/apps/desktop/electron/window-enumeration-protocol.ts
@@ -0,0 +1,114 @@
+import type { EnumeratedWindow, EnumerationFailure } from './window-below'
+
+export const WINDOW_METADATA_MAX_BYTES = 256 * 1024
+export const WINDOW_METADATA_MAX_WINDOWS = 128
+
+interface MetadataPacket {
+  version: 1
+  windows?: EnumeratedWindow[]
+  error?: string
+}
+
+const text = (value: unknown, limit: number) =>
+  typeof value === 'string' ? value.replace(/[\0\r\n]+/g, ' ').slice(0, limit) : ''
+
+const coordinate = (value: unknown) =>
+  typeof value === 'number' && Number.isFinite(value) && Math.abs(value) <= 1_000_000 ? value : 0
+
+const identifier = (value: unknown) =>
+  typeof value === 'number' && Number.isSafeInteger(value) && value >= 0 ? value : 0
+
+/** Metadata only; never copy arbitrary native fields or an unbounded title. */
+export function projectWindowMetadata(raw: unknown): EnumeratedWindow[] | EnumerationFailure {
+  if (!Array.isArray(raw)) {return { reason: 'the window enumerator returned no window list' }}
+
+  return raw
+    .slice(0, WINDOW_METADATA_MAX_WINDOWS)
+    .filter(item => item && typeof item === 'object')
+    .map(item => ({
+      app: text(item.owner?.name, 128),
+      title: text(item.title, 512),
+      id: identifier(item.id),
+      pid: identifier(item.owner?.processId),
+      bounds: {
+        x: coordinate(item.bounds?.x),
+        y: coordinate(item.bounds?.y),
+        width: Math.max(0, coordinate(item.bounds?.width)),
+        height: Math.max(0, coordinate(item.bounds?.height))
+      }
+    }))
+}
+
+export function metadataLine(result: EnumeratedWindow[] | EnumerationFailure): string {
+  const packet: MetadataPacket = Array.isArray(result)
+    ? { version: 1, windows: [...result] }
+    : { version: 1, error: text(result.reason, 512) }
+
+  let encoded = JSON.stringify(packet) + '\n'
+
+  // Retain front-to-back order, trimming only the farthest windows if unusually
+  // long non-ASCII titles would exceed the transport budget.
+  while (Buffer.byteLength(encoded) > WINDOW_METADATA_MAX_BYTES && packet.windows?.length) {
+    packet.windows.pop()
+    encoded = JSON.stringify(packet) + '\n'
+  }
+
+  return encoded
+}
+
+export function parseMetadataLine(line: string): EnumeratedWindow[] | EnumerationFailure {
+  const failure = { reason: 'the window metadata helper returned an invalid bounded response' }
+
+  if (Buffer.byteLength(line) > WINDOW_METADATA_MAX_BYTES) {return failure}
+
+  try {
+    const packet = JSON.parse(line) as MetadataPacket
+
+    if (
+      !packet ||
+      packet.version !== 1 ||
+      Object.keys(packet).some(key => !['version', 'windows', 'error'].includes(key))
+    )
+      {return failure}
+
+    if (typeof packet.error === 'string' && !packet.windows) {return { reason: text(packet.error, 512) }}
+
+    if (
+      !Array.isArray(packet.windows) ||
+      packet.windows.length > WINDOW_METADATA_MAX_WINDOWS ||
+      packet.error !== undefined
+    )
+      {return failure}
+
+    for (const item of packet.windows) {
+      if (
+        !item ||
+        typeof item !== 'object' ||
+        Object.keys(item).some(key => !['app', 'title', 'id', 'pid', 'bounds'].includes(key)) ||
+        typeof item.app !== 'string' ||
+        item.app.length > 128 ||
+        typeof item.title !== 'string' ||
+        item.title.length > 512 ||
+        !Number.isSafeInteger(item.id) ||
+        item.id < 0 ||
+        !Number.isSafeInteger(item.pid) ||
+        item.pid < 0 ||
+        !item.bounds ||
+        Object.keys(item.bounds).some(key => !['x', 'y', 'width', 'height'].includes(key)) ||
+        ['x', 'y', 'width', 'height'].some(
+          key =>
+            typeof item.bounds[key] !== 'number' ||
+            !Number.isFinite(item.bounds[key]) ||
+            Math.abs(item.bounds[key]) > 1_000_000
+        ) ||
+        item.bounds.width < 0 ||
+        item.bounds.height < 0
+      )
+        {return failure}
+    }
+
+    return packet.windows
+  } catch {
+    return failure
+  }
+}
