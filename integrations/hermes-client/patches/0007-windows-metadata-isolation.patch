@@ -0,0 +1,59 @@
+import fs from 'node:fs'
+import path from 'node:path'
+
+import { app, utilityProcess } from 'electron'
+
+import { createWindowEnumerationClient, type MetadataChild } from './window-enumeration-client'
+
+const outsideAsar = (value: string) => value.replace(/app\.asar(?=$|[\\/])/, 'app.asar.unpacked')
+
+const clients = createWindowEnumerationClient(modulePath => {
+  const helper = outsideAsar(path.join(app.getAppPath(), 'dist', 'window-enumeration-worker.mjs'))
+
+  // No model/provider credentials, login tickets, NODE_OPTIONS or foreign
+  // module-resolution knobs are required to read local window metadata.
+  const allowed = new Set([
+    'path',
+    'systemroot',
+    'windir',
+    'temp',
+    'tmp',
+    'userprofile',
+    'localappdata',
+    'appdata',
+    'pathext',
+    'lang',
+    'lc_all'
+  ])
+
+  const env = Object.fromEntries(
+    Object.entries(process.env).filter(([key, value]) => value !== undefined && allowed.has(key.toLowerCase()))
+  )
+
+  return utilityProcess.fork(helper, [modulePath], {
+    env,
+    execArgv: [],
+    stdio: ['ignore', 'pipe', 'ignore'],
+    serviceName: 'MISAKA Window Metadata'
+  }) as MetadataChild
+})
+
+let quitHook = false
+
+export function enumerateWindowsIsolated(options: { signal?: AbortSignal; timeoutMs?: number } = {}) {
+  const modulePath = outsideAsar(path.join(app.getAppPath(), 'dist', 'node_modules', 'get-windows', 'index.js'))
+  const helperPath = outsideAsar(path.join(app.getAppPath(), 'dist', 'window-enumeration-worker.mjs'))
+
+  if (!app.isReady() || !fs.existsSync(modulePath) || !fs.existsSync(helperPath)) {
+    return Promise.resolve({
+      reason: 'the prepared window metadata helper or matching native module is missing; rebuild the native client'
+    })
+  }
+
+  if (!quitHook) {
+    quitHook = true
+    app.on('before-quit', () => clients.stopAll())
+  }
+
+  return clients.read(modulePath, options)
+}
