@@ -0,0 +1,22 @@
+import { pathToFileURL } from 'node:url'
+
+import { metadataLine, projectWindowMetadata } from './window-enumeration-protocol'
+
+/** Runs in Electron's Node-enabled utility process, independent of RunAsNode
+ * fuses. Import exactly the prepared staged native module from this build. */
+async function main() {
+  const modulePath = process.argv[2]
+
+  if (!modulePath) {return metadataLine({ reason: 'the staged window enumerator was not specified' })}
+
+  try {
+    const provider = await import(pathToFileURL(modulePath).href)
+    const raw = await provider.openWindows()
+
+    return metadataLine(projectWindowMetadata(raw))
+  } catch {
+    return metadataLine({ reason: 'the staged native window enumerator could not be loaded or queried' })
+  }
+}
+
+void main().then(line => process.stdout.write(line, () => process.exit(0)))
