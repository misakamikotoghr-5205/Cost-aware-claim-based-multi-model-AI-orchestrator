diff --git a/apps/desktop/src/lib/provider-labels-chinese.test.ts b/apps/desktop/src/lib/provider-labels-chinese.test.ts
new file mode 100644
index 00000000..3b9a039a
--- /dev/null
+++ b/apps/desktop/src/lib/provider-labels-chinese.test.ts
@@ -0,0 +1,144 @@
+import { cleanup, fireEvent, render, screen } from '@testing-library/react'
+import { createElement } from 'react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import { FlowPanel } from '@/components/onboarding/flow'
+import { ProviderRow, providerTitle } from '@/components/onboarding/providers'
+import { I18nProvider, useI18n } from '@/i18n'
+import { makeOAuthProvider } from '@/test/oauth-provider'
+
+import { providerDisplayName } from './model-status-label'
+
+afterEach(cleanup)
+
+const OFFICIAL_LABELS = [
+  ['openai-codex', 'ChatGPT or Codex Subscription', 'ChatGPT 或 Codex 订阅'],
+  ['openai-codex', 'ChatGPT or Codex subscription', 'ChatGPT 或 Codex 订阅'],
+  ['anthropic', 'Anthropic Account', 'Anthropic 账号'],
+  [
+    'claude-code',
+    'Anthropic OAuth: Required Extra Usage Credits to Use Subscription',
+    'Anthropic OAuth：使用订阅需要额外用量额度'
+  ]
+] as const
+
+describe('Chinese provider labels', () => {
+  it.each(OFFICIAL_LABELS)('localizes the official %s label without changing other locales', (id, name, chinese) => {
+    expect(providerDisplayName(id, 'zh', name)).toBe(chinese)
+    expect(providerDisplayName(id, 'en', name)).toBe(name)
+    expect(providerDisplayName(id, 'fr', name)).toBe(name)
+    expect(providerDisplayName(id, 'zh-hant', name)).toBe(name)
+  })
+
+  it('keeps the existing ID mapping when no display name is supplied', () => {
+    expect(providerDisplayName('openai-codex')).toBe('ChatGPT or Codex Subscription')
+    expect(providerDisplayName(' ANTHROPIC ')).toBe('Anthropic Account')
+    expect(providerDisplayName('openai-codex', 'zh')).toBe('ChatGPT 或 Codex 订阅')
+    expect(providerDisplayName('claude-code', 'zh')).toBe('Anthropic OAuth：使用订阅需要额外用量额度')
+    expect(providerDisplayName('custom:lab', 'zh')).toBe('custom:lab')
+    expect(providerDisplayName('constructor', 'zh')).toBe('constructor')
+    expect(providerDisplayName('__proto__', 'zh')).toBe('__proto__')
+    expect(providerDisplayName('nous', 'zh')).toBe('Nous Portal')
+  })
+
+  it('requires both the canonical route and its complete official label', () => {
+    for (const [id, name] of OFFICIAL_LABELS) {
+      expect(providerDisplayName('custom:lab', 'zh', name)).toBe(name)
+      expect(providerDisplayName('another-provider', 'zh', name)).toBe(name)
+      expect(providerDisplayName(id, 'zh', `${name} · work`)).toBe(`${name} · work`)
+      expect(providerDisplayName(id, 'zh', ` ${name} `)).toBe(` ${name} `)
+    }
+
+    expect(providerDisplayName('anthropic', 'zh', 'ChatGPT or Codex Subscription')).toBe(
+      'ChatGPT or Codex Subscription'
+    )
+    expect(providerDisplayName('anthropic', 'zh', 'Anthropic')).toBe('Anthropic')
+    expect(providerDisplayName('anthropic', 'zh', 'anthropic')).toBe('anthropic')
+    expect(providerDisplayName('openai-codex', 'zh', 'My ChatGPT account')).toBe('My ChatGPT account')
+    expect(providerDisplayName('anthropic', 'en', 'Anthropic')).toBe('Anthropic')
+    expect(providerDisplayName('anthropic', 'en', 'My work account')).toBe('My work account')
+  })
+
+  it('retains the OAuth directory canonical English titles while protecting explicit custom names', () => {
+    const provider = makeOAuthProvider('anthropic', 'Anthropic Claude')
+
+    expect(providerTitle(provider)).toBe('Anthropic Account')
+    expect(providerTitle(provider, 'en')).toBe('Anthropic Account')
+    expect(providerTitle(provider, 'de')).toBe('Anthropic Account')
+    expect(providerTitle(provider, 'zh')).toBe('Anthropic Claude')
+    expect(providerDisplayName(provider.id, 'en', provider.name)).toBe('Anthropic Claude')
+    expect(providerTitle(makeOAuthProvider('custom:lab', 'My own provider'), 'en')).toBe('My own provider')
+    expect(providerTitle(makeOAuthProvider('constructor', 'My own provider'), 'en')).toBe('My own provider')
+  })
+
+  it('passes the original OAuth DTO to the sign-in action from a Chinese provider row', () => {
+    const provider = Object.freeze(makeOAuthProvider('anthropic', 'Anthropic Account'))
+    const onSelect = vi.fn()
+
+    render(
+      createElement(I18nProvider, {
+        children: createElement(ProviderRow, { onSelect, provider }),
+        configClient: null,
+        initialLocale: 'zh'
+      })
+    )
+
+    fireEvent.click(screen.getByRole('button', { name: /Anthropic 账号/ }))
+
+    expect(onSelect).toHaveBeenCalledExactlyOnceWith(provider)
+    expect(onSelect.mock.calls[0][0]).toBe(provider)
+    expect(provider.id).toBe('anthropic')
+    expect(provider.name).toBe('Anthropic Account')
+  })
+
+  it('updates the provider row immediately when the display language changes', () => {
+    const provider = Object.freeze(makeOAuthProvider('openai-codex', 'ChatGPT or Codex Subscription'))
+    const onSelect = vi.fn()
+
+    function LanguageToggle() {
+      const { setLocale } = useI18n()
+
+      return createElement('button', { onClick: () => void setLocale('en'), type: 'button' }, 'English')
+    }
+
+    render(
+      createElement(I18nProvider, {
+        children: [
+          createElement(LanguageToggle, { key: 'language' }),
+          createElement(ProviderRow, { key: 'provider', onSelect, provider })
+        ],
+        configClient: null,
+        initialLocale: 'zh'
+      })
+    )
+
+    expect(screen.getByRole('button', { name: /ChatGPT 或 Codex 订阅/ })).toBeTruthy()
+    fireEvent.click(screen.getByRole('button', { name: 'English' }))
+    fireEvent.click(screen.getByRole('button', { name: /ChatGPT or Codex Subscription/ }))
+
+    expect(screen.queryByText('ChatGPT 或 Codex 订阅')).toBeNull()
+    expect(onSelect.mock.calls[0][0]).toBe(provider)
+    expect(provider.name).toBe('ChatGPT or Codex Subscription')
+  })
+
+  it('uses the selected display language in the sign-in progress without changing its provider', () => {
+    const provider = Object.freeze(makeOAuthProvider('anthropic', 'Anthropic Account'))
+
+    render(
+      createElement(I18nProvider, {
+        children: createElement(FlowPanel, {
+          ctx: { requestGateway: async () => undefined as never },
+          flow: { status: 'starting', provider },
+          leaving: false,
+          onBegin: vi.fn()
+        }),
+        configClient: null,
+        initialLocale: 'zh'
+      })
+    )
+
+    expect(screen.getByText(/Anthropic 账号/)).toBeTruthy()
+    expect(provider.name).toBe('Anthropic Account')
+    expect(provider.cli_command).toBe('hermes login anthropic')
+  })
+})
