+      decision: undefined,
+      active: false
+    },
+    {
+      packageName: 'free-models',
+      ownDefault: true,
+      decision: undefined,
+      active: false
+    },
+    {
+      packageName: 'smart-pointer',
+      ownDefault: true,
+      decision: undefined,
+      active: false
+    },
+    {
+      packageName: 'other-package',
+      ownDefault: true,
+      decision: undefined,
+      active: false
+    }
+  ])(
+    'loads $packageName with own default $ownDefault / explicit $decision as active=$active',
+    async ({ packageName, ownDefault, decision, active }) => {
+      const root = '/local/.hermes/desktop-plugins'
+      const folder = `${root}/${packageName}`
+      let present = true
+      desktopPluginsRoot.mockResolvedValue(root)
+      readDir.mockImplementation(async dir => ({
+        entries:
+          dir === root
+            ? present
+              ? [{ isDirectory: true, name: packageName, path: folder }]
+              : []
+            : dir === folder
+              ? [
+                  {
+                    isDirectory: false,
+                    name: '.hermes-package.json',
+                    path: `${folder}/.hermes-package.json`
+                  },
+                  {
+                    isDirectory: false,
+                    name: 'plugin.js',
+                    path: `${folder}/plugin.js`
+                  }
+                ]
+              : []
+      }))
+      readFileText.mockImplementation(async file => ({
+        text: file.endsWith('.hermes-package.json')
+          ? JSON.stringify({ package: packageName })
+          : `export default { id: ${JSON.stringify(packageName)}, defaultEnabled: ${ownDefault}, register() { globalThis.__shippedCoreRegister() } }`
+      }))
+      watchPreviewFile.mockResolvedValue({ id: `watch-${packageName}` })
+      const register = vi.fn()
+
+      const globals = globalThis as unknown as {
+        __shippedCoreRegister?: () => void
+      }
+
+      globals.__shippedCoreRegister = register
+      const oldDecisions = $pluginDecisions.get()
+      const decisions = { ...oldDecisions }
+      delete decisions[packageName]
+      $pluginDecisions.set(decisions)
+
+      const oldStored = localStorage.getItem('hermes.desktop.pluginDecisions.v2')
+
+      const create = vi
+        .spyOn(URL, 'createObjectURL')
+        .mockImplementation(
+          blob =>
+            `data:text/javascript;base64,${Buffer.from((blob as unknown as { parts: string[] }).parts.join('')).toString('base64')}`
+        )
+
+      const revoke = vi.spyOn(URL, 'revokeObjectURL').mockImplementation(() => undefined)
+
+      const RealBlob = globalThis.Blob
+      vi.stubGlobal(
+        'Blob',
+        class {
+          constructor(public parts: string[]) {}
+        }
+      )
+
+      try {
+        if (decision !== undefined) {
+          await setPluginEnabled(packageName, decision)
+        }
+
+        await discoverRuntimePlugins()
+        expect($pluginRecords.get()[packageName]).toMatchObject({
+          packageName,
+          kind: 'disk',
+          status: active ? 'loaded' : 'disabled'
+        })
+        expect(register).toHaveBeenCalledTimes(active ? 1 : 0)
+
+        if (decision === false) {
+          await discoverRuntimePlugins()
+          expect($pluginRecords.get()[packageName].status).toBe('disabled')
+          expect(register).not.toHaveBeenCalled()
+        }
+      } finally {
+        present = false
+        await discoverRuntimePlugins()
+        $pluginDecisions.set(oldDecisions)
+
+        if (oldStored === null) {
+          localStorage.removeItem('hermes.desktop.pluginDecisions.v2')
+        } else {
+          localStorage.setItem('hermes.desktop.pluginDecisions.v2', oldStored)
+        }
+
+        create.mockRestore()
+        revoke.mockRestore()
+        vi.stubGlobal('Blob', RealBlob)
+        delete globals.__shippedCoreRegister
+      }
+    }
+  )
+
+  it('does not invent a core plugin when the installed desktop folder is absent', async () => {
+    desktopPluginsRoot.mockResolvedValue('/local/.hermes/desktop-plugins')
+    readDir.mockResolvedValue({ entries: [] })
+    await discoverRuntimePlugins()
+    expect($pluginRecords.get()['orchestrator-core']).toBeUndefined()
+    expect(readFileText).not.toHaveBeenCalled()
+  })
+})
