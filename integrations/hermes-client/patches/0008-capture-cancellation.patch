+/** Native capture promises may never settle; cancellation must still release the caller. */
+function runCaptureStage<T>(signal: AbortSignal, stage: () => Promise<T>): Promise<T> {
+  return new Promise<T>((resolve, reject) => {
+    let settled = false
+
+    const settle = (deliver: () => void) => {
+      if (settled) {
+        return
+      }
+
+      settled = true
+      signal.removeEventListener('abort', onAbort)
+      deliver()
+    }
+
+    const onAbort = () => settle(() => reject(new Error('Region capture cancelled')))
+
+    if (signal.aborted) {
+      onAbort()
+
+      return
+    }
+
+    signal.addEventListener('abort', onAbort, { once: true })
+
+    try {
+      // Attach both handlers even when abort occurs inside stage(): a late
+      // rejection is observed, but can never deliver a cancelled screen image.
+      Promise.resolve(stage()).then(
+        value => settle(() => resolve(value)),
+        error => settle(() => reject(error))
+      )
+    } catch (error) {
+      settle(() => reject(error))
+    }
+  })
+}
