+const NO_PROVIDER = 'Hermes is not connected to any AI provider yet.'
+const CLI_PICKER = ' Run `hermes model` to pick one'
+const RUNTIME_MISMATCH = ' setup.status reports configured credentials, but runtime resolution still failed.'
+
+/** Only the runtime's known blank-install sentences; unrelated caller failures remain visible. */
+export function isMissingProviderReason(reason: string): boolean {
+  const message = reason.endsWith(RUNTIME_MISMATCH) ? reason.slice(0, -RUNTIME_MISMATCH.length) : reason
+
+  return (
+    message === NO_PROVIDER ||
+    message === `${NO_PROVIDER}${CLI_PICKER}.` ||
+    message === `${NO_PROVIDER}${CLI_PICKER}, or \`hermes auth add <provider>\`.` ||
+    /^Hermes is not connected to any AI provider yet\. Run `hermes model` to pick one, type `\/login` in chat, or add a key with `hermes auth add <provider>`\. \(Advanced: put an API key such as OPENROUTER_API_KEY in [^\r\n]+\.env\.\)$/.test(message)
+  )
+}
