@@ -0,0 +1,53 @@
+import { cleanup, render, screen } from '@testing-library/react'
+import { afterEach, describe, expect, it } from 'vitest'
+
+import { I18nProvider } from '@/i18n'
+import { $desktopOnboarding, type OnboardingContext } from '@/store/onboarding'
+import { markOnboardingDecided } from '@/store/onboarding-presence'
+import { makeOAuthProvider } from '@/test/oauth-provider'
+
+import { DesktopOnboardingOverlay } from '.'
+
+markOnboardingDecided()
+
+const pendingGateway = (() => new Promise(() => {})) as OnboardingContext['requestGateway']
+const initial = $desktopOnboarding.get()
+
+const missingProvider =
+  'Hermes is not connected to any AI provider yet. Run `hermes model` to pick one, type `/login` in chat, or add a key with `hermes auth add <provider>`. (Advanced: put an API key such as OPENROUTER_API_KEY in ~/.hermes/.env.)'
+
+function renderReason(reason: string) {
+  $desktopOnboarding.set({
+    ...initial,
+    configured: false,
+    firstRunSkipped: false,
+    providers: [makeOAuthProvider('anthropic', 'Anthropic Claude')],
+    reason
+  })
+  render(
+    <I18nProvider configClient={null} initialLocale="zh">
+      <DesktopOnboardingOverlay enabled profile="default" requestGateway={pendingGateway} />
+    </I18nProvider>
+  )
+}
+
+afterEach(() => {
+  cleanup()
+  $desktopOnboarding.set(initial)
+})
+
+describe('MISAKA first-run guidance', () => {
+  it('explains a blank install in Chinese when the runtime still reports configured credentials', () => {
+    renderReason(`${missingProvider} setup.status reports configured credentials, but runtime resolution still failed.`)
+
+    expect(screen.getByText('MISAKA AGENT 尚未连接模型。请选择本地模型、OAuth 或 API，也可以稍后配置。')).toBeTruthy()
+    expect(screen.queryByText(/Hermes is not connected|setup.status reports/)).toBeNull()
+  })
+
+  it('keeps a real runtime failure supplied by the caller', () => {
+    const failure = 'Provider endpoint returned HTTP 503. Check https://example.invalid/status.'
+    renderReason(failure)
+
+    expect(screen.getByText(failure)).toBeTruthy()
+  })
+})
