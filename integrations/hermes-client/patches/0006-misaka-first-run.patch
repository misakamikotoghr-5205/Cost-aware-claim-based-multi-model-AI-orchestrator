+/** MISAKA starts with collection and upload explicitly off. Never replace an existing choice. */
+export async function initializeSharedMetricsOff(
+  request: SharedMetricsRequester,
+  stillCurrent: () => boolean
+): Promise<SharedMetricsConsent | null> {
+  const consent = await readSharedMetricsConsent(request)
+
+  if (!stillCurrent()) {
+    return null
+  }
+
+  if (consent?.decided === false && !consent.reask && consent.enabled === false && consent.send === false) {
+    return saveSharedMetricsConsent(request, SHARED_METRICS_CHOICES.off)
+  }
+
+  return consent
+}
+
