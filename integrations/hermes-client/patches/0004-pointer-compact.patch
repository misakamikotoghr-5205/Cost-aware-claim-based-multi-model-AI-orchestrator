index 00000000..dba577da
--- /dev/null
+++ b/apps/desktop/electron/pointer-compact-policy.test.ts
@@ -0,0 +1,61 @@
+import { describe, expect, it } from 'vitest'
+
+import { pointerBounds, pointerHandoff, pointerScope, samePointerScope } from './pointer-compact-policy'
+
+const scope = { sessionId: 'new', profile: 'default', connectionId: 'local' }
+
+describe('pointer compact identity and screen limits', () => {
+  it('pins all three parts of the original composer route', () => {
+    expect(pointerScope(scope)).toEqual(scope)
+
+    for (const key of ['sessionId', 'profile', 'connectionId']) {
+      expect(pointerScope({ ...scope, [key]: '' })).toBeNull()
+      expect(samePointerScope(scope, { ...scope, [key]: 'different' })).toBe(false)
+    }
+
+    expect(pointerScope({ ...scope, token: 'must-not-cross' })).toBeNull()
+    expect(pointerScope({ ...scope, sessionId: 'bad\0id' })).toBeNull()
+  })
+
+  it('uses the right upper corner of a monitor with a negative origin', () => {
+    expect(pointerBounds({ x: -1920, y: -100, width: 1920, height: 1080 })).toEqual({
+      x: -376,
+      y: -84,
+      width: 360,
+      height: 200
+    })
+  })
+
+  it('grows for choices within a fixed small maximum and shrinks to a compact empty state', () => {
+    const area = { x: 0, y: 0, width: 1920, height: 1080 }
+    expect(pointerBounds(area, 80).height).toBe(180)
+    expect(pointerBounds(area, 320).height).toBe(320)
+    expect(pointerBounds(area, 9000).height).toBe(440)
+  })
+
+  it('clamps to a small monitor instead of stranding the controls outside it', () => {
+    const area = { x: 0, y: 0, width: 300, height: 240 }
+    const result = pointerBounds(area)
+    expect(result.x).toBeGreaterThanOrEqual(area.x)
+    expect(result.y).toBeGreaterThanOrEqual(area.y)
+    expect(result.x + result.width).toBeLessThanOrEqual(area.width)
+    expect(result.y + result.height).toBeLessThanOrEqual(area.height)
+  })
+
+  it('accepts a bounded confirmed text draft and optionally one inline cropped PNG', () => {
+    expect(pointerHandoff({ scope, generation: 'g', text: 'Draft' })).toEqual({ scope, generation: 'g', text: 'Draft' })
+    expect(
+      pointerHandoff({ scope, generation: 'g', text: 'Draft', imageDataUrl: 'data:image/png;base64,aGVsbG8=' })
+    ).not.toBeNull()
+  })
+
+  it('rejects executable/remote image payloads, unknown fields and oversized text', () => {
+    for (const imageDataUrl of ['https://example.com/screen.png', 'data:image/svg+xml,<svg/>', 'file:///screen.png']) {
+      expect(pointerHandoff({ scope, generation: 'g', text: 'Draft', imageDataUrl })).toBeNull()
+    }
+
+    expect(pointerHandoff({ scope, generation: 'g', text: 'x'.repeat(32_769) })).toBeNull()
+    expect(pointerHandoff({ scope, generation: 'g', text: 'Draft', submit: true })).toBeNull()
+    expect(pointerHandoff({ scope, generation: 'g', text: '' })).toBeNull()
+  })
+})
diff --git a/apps/desktop/electron/pointer-compact-policy.ts b/apps/desktop/electron/pointer-compact-policy.ts
new file mode 100644
index 00000000..e01b0f79
--- /dev/null
+++ b/apps/desktop/electron/pointer-compact-policy.ts
@@ -0,0 +1,89 @@
+import type { PointerScope } from './pointer-compact-types'
+
+export function pointerScope(value: unknown): PointerScope | null {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return null
+  }
+
+  const item = value as Record<string, unknown>
+
+  if (Object.keys(item).some(key => !['sessionId', 'profile', 'connectionId'].includes(key))) {
+    return null
+  }
+
+  if (
+    ['sessionId', 'profile', 'connectionId'].some(
+      key =>
+        typeof item[key] !== 'string' ||
+        !(item[key] as string).trim() ||
+        (item[key] as string).length > 256 ||
+        /[\0\r\n]/.test(item[key] as string)
+    )
+  ) {
+    return null
+  }
+
+  return {
+    sessionId: item.sessionId as string,
+    profile: item.profile as string,
+    connectionId: item.connectionId as string
+  }
+}
+
+export function samePointerScope(left: PointerScope, right: PointerScope): boolean {
+  return (
+    left.sessionId === right.sessionId && left.profile === right.profile && left.connectionId === right.connectionId
+  )
+}
+
+/** Top-right of this monitor's usable area, including negative desktop origins. */
+export function pointerBounds(area: { x: number; y: number; width: number; height: number }, requestedHeight = 200) {
+  const margin = Math.min(16, Math.max(0, Math.floor(Math.min(area.width, area.height) / 20)))
+  const width = Math.max(1, Math.min(360, area.width - margin * 2))
+  const height = Math.max(1, Math.min(Math.max(180, Math.min(440, requestedHeight)), area.height - margin * 2))
+
+  return { x: area.x + area.width - margin - width, y: area.y + margin, width, height }
+}
+
+export function pointerHandoff(
+  value: unknown
+): { generation: string; scope: PointerScope; text: string; imageDataUrl?: string } | null {
+  if (!value || typeof value !== 'object' || Array.isArray(value)) {
+    return null
+  }
+
+  const item = value as Record<string, unknown>
+
+  if (Object.keys(item).some(key => !['generation', 'scope', 'text', 'imageDataUrl'].includes(key))) {
+    return null
+  }
+
+  const scope = pointerScope(item.scope)
+
+  if (
+    !scope ||
+    typeof item.generation !== 'string' ||
+    item.generation.length > 80 ||
+    typeof item.text !== 'string' ||
+    !item.text.trim() ||
+    item.text.length > 32_768
+  ) {
+    return null
+  }
+
+  if (
+    item.imageDataUrl !== undefined &&
+    (typeof item.imageDataUrl !== 'string' ||
+      item.imageDataUrl.length > 12 * 1024 * 1024 ||
+      !/^data:image\/png;base64,[A-Za-z0-9+/]+={0,2}$/.test(item.imageDataUrl))
+  ) {
+    return null
+  }
+
+  return {
+    generation: item.generation,
+    scope,
+    text: item.text,
+    ...(item.imageDataUrl ? { imageDataUrl: item.imageDataUrl as string } : {})
+  }
+}
diff --git a/apps/desktop/electron/pointer-compact-types.ts b/apps/desktop/electron/pointer-compact-types.ts
new file mode 100644
index 00000000..1f258842
--- /dev/null
+++ b/apps/desktop/electron/pointer-compact-types.ts
@@ -0,0 +1,35 @@
+export interface PointerScope {
+  sessionId: string
+  profile: string
+  connectionId: string
+}
+
+export interface PointerCompactContext {
+  generation: string
+  scope: PointerScope
+}
+
+export interface PointerDelivery extends PointerCompactContext {
+  requestId: string
+  text: string
+  imageDataUrl?: string
+}
+
+export interface PointerDeliveryResult {
+  ok: boolean
+  message?: string
+}
+
+export interface PointerCompactApi {
+  /** Set only for the native compact renderer; contains no auth material. */
+  context: PointerCompactContext | null
+  open: (scope: PointerScope) => Promise<PointerDeliveryResult>
+  close: () => Promise<boolean>
+  /** Compact-window-only sizing request, clamped to the current usable monitor. */
+  resize: (height: number) => Promise<boolean>
+  handoff: (payload: Omit<PointerDelivery, 'requestId'>) => Promise<PointerDeliveryResult>
+  isCurrent: (requestId: string, generation: string) => Promise<boolean>
+  ack: (requestId: string, generation: string, result: PointerDeliveryResult) => void
+  onDelivery: (callback: (payload: PointerDelivery) => void) => () => void
+  onCancelled: (callback: (requestId: string) => void) => () => void
+}
diff --git a/apps/desktop/electron/pointer-compact.ts b/apps/desktop/electron/pointer-compact.ts
new file mode 100644
index 00000000..e74a5284
--- /dev/null
+++ b/apps/desktop/electron/pointer-compact.ts
@@ -0,0 +1,325 @@
+import { createHash, randomUUID } from 'node:crypto'
+
+import { app, BrowserWindow, ipcMain, type IpcMainEvent, type IpcMainInvokeEvent, nativeImage, screen } from 'electron'
+
+import { pointerBounds, pointerHandoff, pointerScope, samePointerScope } from './pointer-compact-policy'
+import type { PointerCompactContext, PointerDeliveryResult } from './pointer-compact-types'
+
+/** A local capture surface, not another chat or gateway owner. The hidden
+ * owner renderer remains mounted and is the sole authority for its composer. */
+export function installPointerCompact({ rendererUrl, preloadPath }: { rendererUrl: string; preloadPath: string }) {
+  const expected = new URL(rendererUrl)
+
+  let current: {
+    owner: BrowserWindow
+    window: BrowserWindow
+    context: PointerCompactContext
+    delivered: Set<string>
+    detach: () => void
+    delivery?: {
+      id: string
+      key: string
+      resolve: (result: PointerDeliveryResult) => void
+      timer: ReturnType<typeof setTimeout>
+    }
+  } | null = null
+
+  const trusted = (event: IpcMainEvent | IpcMainInvokeEvent) => {
+    if (event.senderFrame !== event.sender.mainFrame) {
+      return null
+    }
+
+    const win = BrowserWindow.fromWebContents(event.sender)
+
+    if (!win || win.isDestroyed()) {
+      return null
+    }
+
+    try {
+      const actual = new URL(event.senderFrame.url)
+
+      if (
+        actual.protocol !== expected.protocol ||
+        actual.host !== expected.host ||
+        actual.pathname !== expected.pathname
+      ) {
+        return null
+      }
+
+      return win
+    } catch {
+      return null
+    }
+  }
+
+  const complete = (result: PointerDeliveryResult) => {
+    const item = current?.delivery
+
+    if (!item) {
+      return
+    }
+
+    if (result.ok) {
+      current.delivered.add(item.key)
+    }
+
+    current.delivery = undefined
+    clearTimeout(item.timer)
+    item.resolve(result)
+  }
+
+  const close = (restore = true) => {
+    const item = current
+
+    if (!item) {
+      return false
+    }
+
+    if (item.delivery && !item.owner.isDestroyed()) {
+      item.owner.webContents.send('hermes:pointer-compact:cancelled', item.delivery.id)
+    }
+
+    complete({ ok: false, message: '智能指针窗口已关闭；请检查原聊天草稿。' })
+    current = null
+    item.detach()
+
+    if (!item.window.isDestroyed()) {
+      item.window.destroy()
+    }
+
+    if (restore && !item.owner.isDestroyed()) {
+      if (item.owner.isMinimized()) {
+        item.owner.restore()
+      }
+
+      item.owner.show()
+      item.owner.focus()
+    }
+
+    return true
+  }
+
+  ipcMain.on('hermes:pointer-compact:context', event => {
+    event.returnValue = trusted(event) === current?.window ? current.context : null
+  })
+
+  ipcMain.handle('hermes:pointer-compact:open', async (event, input) => {
+    const owner = trusted(event)
+    const scope = pointerScope(input)
+
+    if (!owner || !scope || new URL(event.senderFrame.url).searchParams.get('win') === 'pointer') {
+      return { ok: false, message: '需要从原生聊天打开智能指针。' }
+    }
+
+    if (current) {
+      if (current.owner === owner && samePointerScope(current.context.scope, scope)) {
+        current.window.show()
+        current.window.focus()
+        owner.hide()
+
+        return { ok: true }
+      }
+
+      close()
+    }
+
+    const area = screen.getDisplayMatching(owner.getBounds()).workArea
+
+    const win = new BrowserWindow({
+      ...pointerBounds(area),
+      frame: false,
+      show: false,
+      alwaysOnTop: true,
+      skipTaskbar: true,
+      resizable: true,
+      minimizable: false,
+      maximizable: false,
+      fullscreenable: false,
+      title: '智能指针',
+      backgroundColor: '#f8fafc',
+      webPreferences: { preload: preloadPath, contextIsolation: true, sandbox: true, nodeIntegration: false }
+    })
+
+    const context = { generation: randomUUID(), scope }
+    const onOwnerGone = () => close(false)
+
+    const onOwnerNavigate = (_event: unknown, _url: string, _inPlace: boolean, mainFrame: boolean) => {
+      if (mainFrame) {
+        close()
+      }
+    }
+
+    owner.once('closed', onOwnerGone)
+    owner.webContents.on('did-start-navigation', onOwnerNavigate)
+    current = {
+      owner,
+      window: win,
+      context,
+      delivered: new Set(),
+      detach: () => {
+        owner.removeListener('closed', onOwnerGone)
+
+        if (!owner.webContents.isDestroyed()) {
+          owner.webContents.removeListener('did-start-navigation', onOwnerNavigate)
+        }
+      }
+    }
+    win.webContents.setWindowOpenHandler(() => ({ action: 'deny' }))
+    win.webContents.on('will-navigate', event => event.preventDefault())
+    win.webContents.on('before-input-event', (event, input) => {
+      if (input.type === 'keyDown' && input.key === 'Escape' && !input.isAutoRepeat) {
+        event.preventDefault()
+        close()
+      }
+    })
+    win.webContents.once('render-process-gone', () => close())
+    win.once('closed', () => {
+      if (current?.window === win) {
+        close()
+      }
+    })
+    const target = new URL(rendererUrl)
+    target.searchParams.set('win', 'pointer')
+    target.hash = ''
+
+    try {
+      await win.loadURL(target.toString())
+
+      if (current?.window !== win || owner.isDestroyed()) {
+        return { ok: false }
+      }
+
+      owner.hide()
+      win.show()
+      win.focus()
+
+      return { ok: true }
+    } catch {
+      close()
+
+      return { ok: false, message: '无法打开智能指针浮框；主窗口已恢复。' }
+    }
+  })
+
+  ipcMain.handle('hermes:pointer-compact:close', event => {
+    const caller = trusted(event)
+
+    return current && (caller === current.window || caller === current.owner) ? close() : false
+  })
+
+  ipcMain.handle('hermes:pointer-compact:resize', (event, height) => {
+    const item = current
+
+    if (!item || trusted(event) !== item.window || !Number.isInteger(height) || height < 0 || height > 10_000) {
+      return false
+    }
+
+    const previous = item.window.getBounds()
+    const area = screen.getDisplayMatching(previous).workArea
+    const bounds = pointerBounds(area, height)
+    item.window.setBounds({
+      ...bounds,
+      x: Math.max(area.x, Math.min(previous.x, area.x + area.width - bounds.width)),
+      y: Math.max(area.y, Math.min(previous.y, area.y + area.height - bounds.height))
+    })
+
+    return true
+  })
+
+  ipcMain.handle('hermes:pointer-compact:handoff', async (event, input) => {
+    const item = current
+    const payload = pointerHandoff(input)
+
+    if (
+      !item ||
+      trusted(event) !== item.window ||
+      !payload ||
+      payload.generation !== item.context.generation ||
+      !samePointerScope(payload.scope, item.context.scope) ||
+      item.owner.isDestroyed()
+    ) {
+      return { ok: false, message: '原聊天已改变，请返回聊天后重新打开智能指针。' }
+    }
+
+    if (item.delivery) {
+      return { ok: false, message: '上一份草稿仍在确认，请稍候。' }
+    }
+
+    const key = createHash('sha256')
+      .update(payload.text)
+      .update('\0')
+      .update(payload.imageDataUrl || '')
+      .digest('hex')
+
+    if (item.delivered.has(key)) {
+      return { ok: true }
+    }
+
+    if (item.delivered.size >= 32) {
+      return { ok: false, message: '请返回聊天检查草稿，再重新打开智能指针。' }
+    }
+
+    if (payload.imageDataUrl) {
+      const bytes = Buffer.from(payload.imageDataUrl.slice(payload.imageDataUrl.indexOf(',') + 1), 'base64')
+      const image = nativeImage.createFromBuffer(bytes)
+      const size = image.getSize()
+
+      if (bytes.length > 8 * 1024 * 1024 || image.isEmpty() || size.width * size.height > 16_777_216) {
+        return { ok: false, message: '选区图片无效或过大，请重新框选。' }
+      }
+    }
+
+    const id = randomUUID()
+
+    return await new Promise<PointerDeliveryResult>(resolve => {
+      const timer = setTimeout(() => {
+        if (current === item && item.delivery?.id === id) {
+          item.owner.webContents.send('hermes:pointer-compact:cancelled', id)
+          complete({ ok: false, message: '原聊天未确认接收。请返回聊天检查草稿后重试。' })
+        }
+      }, 12_000)
+
+      item.delivery = { id, key, resolve, timer }
+      item.owner.webContents.send('hermes:pointer-compact:delivery', { ...payload, requestId: id })
+    })
+  })
+
+  ipcMain.handle('hermes:pointer-compact:current', (event, id, generation) =>
+    Boolean(
+      current &&
+      trusted(event) === current.owner &&
+      generation === current.context.generation &&
+      current.delivery?.id === id
+    )
+  )
+
+  ipcMain.on('hermes:pointer-compact:ack', (event, id, generation, result) => {
+    if (
+      !current ||
+      trusted(event) !== current.owner ||
+      current.context.generation !== generation ||
+      current.delivery?.id !== id
+    ) {
+      return
+    }
+
+    complete({
+      ok: result?.ok === true,
+      ...(typeof result?.message === 'string' ? { message: result.message.slice(0, 500) } : {})
+    })
+  })
+
+  const reposition = () => {
+    if (!current || current.window.isDestroyed()) {
+      return
+    }
+
+    current.window.setBounds(pointerBounds(screen.getDisplayMatching(current.window.getBounds()).workArea))
+  }
+
+  screen.on('display-removed', reposition)
+  screen.on('display-metrics-changed', reposition)
+  app.once('before-quit', () => close(false))
+
+  return () => close()
+}
