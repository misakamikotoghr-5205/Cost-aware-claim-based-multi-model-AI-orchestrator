@@ -0,0 +1,121 @@
+import { webcrypto } from 'node:crypto'
+
+import { afterEach, beforeEach, expect, it, vi } from 'vitest'
+
+const mocks = vi.hoisted(() => ({
+  scope: { sessionId: 'chat', profile: 'work', connectionId: 'cloud' },
+  attach: vi.fn(),
+  insert: vi.fn()
+}))
+
+vi.mock('@/sdk', () => ({
+  host: {
+    state: {
+      focusedSessionOwner: { get: () => ({ profile: mocks.scope.profile, connectionId: mocks.scope.connectionId }) },
+      focusedStoredSessionId: { get: () => mocks.scope.sessionId },
+      focusedSessionId: { get: () => mocks.scope.sessionId },
+      focusedSessionProfile: { get: () => mocks.scope.profile },
+      connectionId: { get: () => mocks.scope.connectionId }
+    },
+    composer: { attachImages: mocks.attach, insertText: mocks.insert }
+  }
+}))
+import { installPointerOwnerBridge } from './owner-bridge'
+
+let delivery: (payload: any) => void
+let cancelled: (id: string) => void
+let api: any
+
+const payload = () => ({
+  generation: 'g',
+  requestId: crypto.randomUUID(),
+  scope: { ...mocks.scope },
+  text: 'Reviewed draft',
+  imageDataUrl: 'data:image/png;base64,aGVsbG8='
+})
+
+const settle = async () => {
+  for (let i = 0; i < 20; i++) {await new Promise(resolve => setTimeout(resolve, 2))}
+}
+
+beforeEach(() => {
+  vi.stubGlobal('crypto', webcrypto)
+  mocks.scope = { sessionId: 'chat', profile: 'work', connectionId: 'cloud' }
+  mocks.attach.mockReset().mockResolvedValue(true)
+  mocks.insert.mockReset().mockResolvedValue(true)
+  api = {
+    context: null,
+    onDelivery: vi.fn(fn => {
+      delivery = fn
+
+      return () => undefined
+    }),
+    onCancelled: vi.fn(fn => {
+      cancelled = fn
+
+      return () => undefined
+    }),
+    isCurrent: vi.fn(async () => true),
+    ack: vi.fn()
+  }
+  ;(window as any).hermesDesktop = { pointerCompact: api }
+})
+afterEach(() => vi.unstubAllGlobals())
+
+it('only the original ordinary renderer claims composer deliveries', () => {
+  api.context = { generation: 'g', scope: mocks.scope }
+  installPointerOwnerBridge()
+  expect(api.onDelivery).not.toHaveBeenCalled()
+})
+
+it('rejects a changed owner connection before attaching or inserting anything', async () => {
+  installPointerOwnerBridge()
+  const request = payload()
+  mocks.scope.connectionId = 'different'
+  delivery(request)
+  await settle()
+  expect(mocks.attach).not.toHaveBeenCalled()
+  expect(mocks.insert).not.toHaveBeenCalled()
+  expect(api.ack).toHaveBeenCalledWith(request.requestId, 'g', expect.objectContaining({ ok: false }))
+})
+
+it('waits for real image ingestion then inserts text addressed to the frozen session', async () => {
+  installPointerOwnerBridge()
+  const request = payload()
+  delivery(request)
+  await settle()
+  expect(mocks.attach).toHaveBeenCalledWith('chat', [expect.any(Blob)])
+  expect(mocks.insert).toHaveBeenCalledWith('chat', 'Reviewed draft', { mode: 'block' })
+  expect(api.ack).toHaveBeenCalledWith(request.requestId, 'g', { ok: true })
+})
+
+it('cancellation during image ingestion prevents later text insertion', async () => {
+  let finish: (value: boolean) => void = () => undefined
+  mocks.attach.mockImplementation(
+    () =>
+      new Promise(resolve => {
+        finish = resolve
+      })
+  )
+  installPointerOwnerBridge()
+  const request = payload()
+  delivery(request)
+  await settle()
+  cancelled(request.requestId)
+  finish(true)
+  await settle()
+  expect(mocks.insert).not.toHaveBeenCalled()
+  expect(api.ack).toHaveBeenCalledWith(request.requestId, 'g', expect.objectContaining({ ok: false }))
+})
+
+it('a text retry after a partial delivery does not attach the same cropped image twice', async () => {
+  mocks.insert.mockResolvedValueOnce(false)
+  const dispose = installPointerOwnerBridge()
+  delivery(payload())
+  await settle()
+  delivery(payload())
+  await settle()
+  expect(mocks.attach).toHaveBeenCalledTimes(1)
+  expect(mocks.insert).toHaveBeenCalledTimes(2)
+  dispose()
+})
diff --git a/apps/desktop/src/app/pointer-compact/owner-bridge.ts b/apps/desktop/src/app/pointer-compact/owner-bridge.ts
