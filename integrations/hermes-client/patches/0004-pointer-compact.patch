index 00000000..8e25540a
--- /dev/null
+++ b/apps/desktop/src/app/pointer-compact/owner-bridge.ts
@@ -0,0 +1,112 @@
+import { host } from '@/sdk'
+
+import { samePointerScope } from '../../../electron/pointer-compact-policy'
+import type { PointerScope } from '../../../electron/pointer-compact-types'
+
+export function focusedPointerScope(): PointerScope {
+  const owner = host.state.focusedSessionOwner.get()
+
+  return {
+    sessionId: host.state.focusedStoredSessionId.get() ?? host.state.focusedSessionId.get() ?? 'new',
+    profile: owner?.profile ?? host.state.focusedSessionProfile.get(),
+    connectionId: owner?.connectionId ?? host.state.connectionId.get() ?? ''
+  }
+}
+
+/** The small capture window has no gateway/composer of its own. Only this
+ * still-mounted original renderer can acknowledge a real draft insertion. */
+export function installPointerOwnerBridge(): () => void {
+  const api = window.hermesDesktop?.pointerCompact
+
+  if (!api || api.context) {
+    return () => undefined
+  }
+
+  const pending = new Set<string>()
+  const acceptedImages = new Set<string>()
+  const offCancelled = api.onCancelled(id => pending.delete(id))
+
+  const offDelivery = api.onDelivery(payload => {
+    if (pending.has(payload.requestId)) {
+      return
+    }
+
+    pending.add(payload.requestId)
+
+    const current = async () =>
+      pending.has(payload.requestId) &&
+      samePointerScope(payload.scope, focusedPointerScope()) &&
+      (await api.isCurrent(payload.requestId, payload.generation))
+
+    void (async () => {
+      let imageAccepted = false
+
+      try {
+        if (!(await current())) {
+          throw new Error('聊天、连接或窗口已改变，请返回原聊天重新打开智能指针。')
+        }
+
+        if (payload.imageDataUrl) {
+          const encoded = payload.imageDataUrl.slice(payload.imageDataUrl.indexOf(',') + 1)
+          const bytes = Uint8Array.from(atob(encoded), char => char.charCodeAt(0))
+          const digest = await crypto.subtle.digest('SHA-256', bytes)
+
+          const imageKey =
+            payload.generation +
+            ':' +
+            Array.from(new Uint8Array(digest), byte => byte.toString(16).padStart(2, '0')).join('')
+
+          if (!(await current())) {
+            return
+          }
+
+          imageAccepted =
+            acceptedImages.has(imageKey) ||
+            (await host.composer.attachImages(payload.scope.sessionId, [new Blob([bytes], { type: 'image/png' })]))
+
+          if (!imageAccepted) {
+            throw new Error('原生聊天没有确认接收选区图片。')
+          }
+
+          acceptedImages.add(imageKey)
+
+          if (acceptedImages.size > 32) {
+            acceptedImages.delete(acceptedImages.values().next().value!)
+          }
+        }
+
+        if (!(await current())) {
+          throw new Error('聊天已改变，未加入文字草稿。请检查原聊天附件。')
+        }
+
+        const accepted = await host.composer.insertText(payload.scope.sessionId, payload.text, { mode: 'block' })
+        api.ack(
+          payload.requestId,
+          payload.generation,
+          accepted
+            ? { ok: true }
+            : {
+                ok: false,
+                message: imageAccepted
+                  ? '图片已加入，但文字未确认。请返回聊天检查草稿。'
+                  : '原聊天输入框尚未就绪，草稿仍保留在浮框。'
+              }
+        )
+      } catch (error) {
+        api.ack(payload.requestId, payload.generation, {
+          ok: false,
+          message: error instanceof Error ? error.message : '草稿接收失败。'
+        })
+      } finally {
+        pending.delete(payload.requestId)
+      }
+    })()
+  })
+
+  return () => {
+    pending.clear()
+    acceptedImages.clear()
+    offCancelled()
+    offDelivery()
+  }
+}
