@@ -0,0 +1,235 @@
+import { QueryClientProvider } from '@tanstack/react-query'
+import { StrictMode, useEffect, useState } from 'react'
+import { createRoot } from 'react-dom/client'
+
+import { ErrorBoundary } from '@/components/error-boundary'
+import { HapticsProvider } from '@/components/haptics-provider'
+import { RootTooltipProvider } from '@/components/ui/tooltip'
+import { ContribBoundary, ContribRender } from '@/contrib/react/boundary'
+import { useContributions } from '@/contrib/react/use-contributions'
+import { loadRuntimePlugin, unloadRuntimePlugin } from '@/contrib/runtime-loader'
+import { ProfileI18nProvider } from '@/i18n/profile-provider'
+import { isReadFileErrorResult } from '@/lib/desktop-fs'
+import { queryClient } from '@/lib/query-client'
+import { ThemeProvider } from '@/themes/context'
+
+/** Reuse the installed, admitted package and its SDK entry. No bundled pointer
+ * implementation, second chat, gateway dial or background plugin discovery. */
+async function loadPointer() {
+  const desktop = window.hermesDesktop
+
+  if (!desktop?.pointerCompact?.context) {
+    throw new Error('智能指针窗口身份无效，请返回聊天重试。')
+  }
+
+  const resolveRoot = desktop.desktopPluginsRoot
+
+  if (!resolveRoot) {
+    throw new Error('请更新原生客户端后重试。')
+  }
+
+  const root = await resolveRoot()
+
+  const folder = (await desktop.readDir(root)).entries.find(
+    entry => entry.name === 'smart-pointer' && entry.isDirectory
+  )
+
+  if (!folder) {
+    throw new Error('请先在客户端安装智能指针扩展。')
+  }
+
+  const file = (await desktop.readDir(folder.path)).entries.find(
+    entry => entry.name === 'plugin.js' && !entry.isDirectory
+  )
+
+  if (!file) {
+    throw new Error('智能指针扩展缺少界面，请重新安装。')
+  }
+
+  const source = await desktop.readFileText(file.path)
+
+  if (isReadFileErrorResult(source)) {
+    throw new Error('无法读取智能指针扩展。')
+  }
+
+  const id = await loadRuntimePlugin(source.text, 'smart-pointer', {
+    defaultEnabled: false,
+    file: file.path,
+    packageName: 'smart-pointer'
+  })
+
+  if (id !== 'smart-pointer') {
+    throw new Error('智能指针扩展版本不匹配。')
+  }
+}
+
+function CompactSurface() {
+  const panes = useContributions('panes')
+  const pane = panes.find(item => item.id === 'smart-pointer:pane' && item.source === 'plugin:smart-pointer')
+  const [error, setError] = useState('')
+  const [loaded, setLoaded] = useState(false)
+  useEffect(() => {
+    let active = true
+    void loadPointer()
+      .then(() => {
+        if (active) {
+          setLoaded(true)
+        }
+      })
+      .catch(error => {
+        if (active) {
+          setError(String(error.message || error))
+        }
+      })
+
+    return () => {
+      active = false
+      unloadRuntimePlugin('smart-pointer')
+    }
+  }, [])
+  useEffect(() => {
+    const dismiss = (event: KeyboardEvent) => {
+      if (event.key === 'Escape' && !event.isComposing) {
+        event.preventDefault()
+        void window.hermesDesktop.pointerCompact?.close()
+      }
+    }
+
+    window.addEventListener('keydown', dismiss, true)
+
+    return () => window.removeEventListener('keydown', dismiss, true)
+  }, [])
+  useEffect(() => {
+    let frame = 0
+    let previousHeight = 0
+    let measured: Element | null = null
+
+    const fit = () => {
+      frame = 0
+      const content = document.querySelector('[data-pointer-content]')
+
+      if (content !== measured) {
+        if (measured) {observer.unobserve(measured)}
+        measured = content
+
+        if (content) {observer.observe(content)}
+      }
+
+      if (!content) {return}
+      const header = document.querySelector('[data-pointer-header]')
+
+      const height = Math.max(
+        180,
+        Math.min(
+          440,
+          Math.ceil(content.getBoundingClientRect().height + (header?.getBoundingClientRect().height || 34))
+        )
+      )
+
+      if (height === previousHeight) {return}
+      previousHeight = height
+      void window.hermesDesktop.pointerCompact?.resize(height)
+    }
+
+    const schedule = () => {
+      if (!frame) {frame = requestAnimationFrame(fit)}
+    }
+
+    const observer = new ResizeObserver(schedule)
+    const mutations = new MutationObserver(schedule)
+    mutations.observe(document.getElementById('root')!, {
+      childList: true,
+      subtree: true,
+      attributes: true,
+      attributeFilter: ['open']
+    })
+    schedule()
+
+    return () => {
+      cancelAnimationFrame(frame)
+      observer.disconnect()
+      mutations.disconnect()
+    }
+  }, [])
+
+  return (
+    <div
+      className="pointer-window"
+      style={{
+        height: '100vh',
+        display: 'flex',
+        flexDirection: 'column',
+        color: 'var(--foreground)',
+        background: 'var(--background)'
+      }}
+    >
+      <header
+        data-pointer-header
+        style={
+          {
+            display: 'flex',
+            alignItems: 'center',
+            justifyContent: 'space-between',
+            padding: '8px 12px',
+            borderBottom: '1px solid var(--border)',
+            flexShrink: 0,
+            WebkitAppRegion: 'drag'
+          } as React.CSSProperties
+        }
+      >
+        <strong style={{ fontSize: 12 }}>智能指针</strong>
+        <button
+          aria-label="返回聊天并关闭智能指针"
+          onClick={() => void window.hermesDesktop.pointerCompact?.close()}
+          style={
+            {
+              border: 0,
+              background: 'transparent',
+              cursor: 'pointer',
+              fontSize: 12,
+              WebkitAppRegion: 'no-drag'
+            } as React.CSSProperties
+          }
+        >
+          返回聊天 ×
+        </button>
+      </header>
+      <main style={{ minHeight: 0, flex: 1, overflow: 'hidden' }}>
+        {error || (loaded && !pane?.render) ? (
+          <div role="alert" style={{ padding: 16, fontSize: 12 }}>
+            {error || '请在原生 Capabilities → Plugins 中启用智能指针 Desktop 界面。'}
+          </div>
+        ) : pane?.render ? (
+          <ContribBoundary id={pane.id}>
+            <ContribRender render={pane.render} />
+          </ContribBoundary>
+        ) : (
+          <p role="status" style={{ padding: 16 }}>
+            正在打开智能指针…
+          </p>
+        )}
+      </main>
+    </div>
+  )
+}
+
+export function mountPointerCompact() {
+  document.title = '智能指针'
+  createRoot(document.getElementById('root')!).render(
+    <StrictMode>
+      <ErrorBoundary label="pointer-compact">
+        <QueryClientProvider client={queryClient}>
+          <ProfileI18nProvider>
+            <ThemeProvider>
+              <HapticsProvider>
+                <RootTooltipProvider>
+                  <CompactSurface />
+                </RootTooltipProvider>
+              </HapticsProvider>
+            </ThemeProvider>
+          </ProfileI18nProvider>
+        </QueryClientProvider>
+      </ErrorBoundary>
+    </StrictMode>
+  )
+}
