+import { act, cleanup, renderHook } from '@testing-library/react'
+import type { PropsWithChildren } from 'react'
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest'
+
+import { PaneVisibleContext } from '@/components/pane-shell/pane-visibility'
+import { composerHost } from '@/sdk/composer'
+import { createComposerAttachmentScope } from '@/store/composer'
+import { $activeGatewayRoute } from '@/store/gateway'
+import { $activeGatewayProfile } from '@/store/profile'
+import { $activeSessionId, $connection, $selectedStoredSessionId, $sessions } from '@/store/session'
+import { $sessionStates } from '@/store/session-states'
+
+import { markActiveComposer } from '../focus'
+import { ComposerScopeProvider, ComposerSurfaceProvider, MAIN_COMPOSER_SCOPE } from '../scope'
+import type { ChatBarProps } from '../types'
+
+import { useComposerImageRequests } from './use-composer-image-requests'
+
+const png = () => new Blob([new Uint8Array([1, 2, 3])], { type: 'image/png' })
+
+function mount(
+  attach: NonNullable<ChatBarProps['onAttachImageBlob']>,
+  {
+    target = 'main',
+    surface = 'surface-a',
+    session = 'a',
+    visible = true,
+    connectionId = 'local',
+    profile = 'default',
+    disabled = false
+  } = {}
+) {
+  const scope = { ...MAIN_COMPOSER_SCOPE, target, connectionId, profile, attachments: createComposerAttachmentScope() }
+
+  const Wrapper = ({ children }: PropsWithChildren) => (
+    <PaneVisibleContext value={visible}>
+      <ComposerScopeProvider value={scope}>
+        <ComposerSurfaceProvider value={surface}>
+          <div
+            data-composer-surface-id={surface}
+            data-composer-target={target}
+            data-pane-hidden={visible ? undefined : ''}
+          >
+            {children}
+          </div>
+        </ComposerSurfaceProvider>
+      </ComposerScopeProvider>
+    </PaneVisibleContext>
+  )
+
+  return renderHook(
+    ({ sessionKey }) =>
+      useComposerImageRequests({
+        sessionId: sessionKey,
+        sessionKey,
+        inputDisabled: disabled,
+        onAttachImageBlob: attach
+      }),
+    {
+      initialProps: { sessionKey: session },
+      wrapper: Wrapper
+    }
+  )
+}
+
+beforeEach(() => {
+  $connection.set({ connectionId: 'local', mode: 'local' } as never)
+  $activeGatewayProfile.set('default')
+  $activeGatewayRoute.set('default')
+  $selectedStoredSessionId.set('a')
+  $activeSessionId.set('runtime-a')
+  $sessionStates.set({ 'runtime-a': { storedSessionId: 'a' } } as never)
+  $sessions.set([
+    { id: 'a', connection_id: 'local', profile: 'default' },
+    { id: 'b', connection_id: 'local', profile: 'default' }
+  ] as never)
+  markActiveComposer('main')
+})
+
+afterEach(() => {
+  cleanup()
+  vi.useRealTimers()
+  $sessionStates.set({})
+  $selectedStoredSessionId.set(null)
+  $activeSessionId.set(null)
+  $sessions.set([])
+  $connection.set(null)
+  markActiveComposer('main')
+})
+
+describe('SDK image drafts use the mounted composer ingestion acknowledgement', () => {
+  it('waits for native image ingestion and stages only in the addressed composer without submitting', async () => {
+    let complete!: (ok: boolean) => void
+
+    const attachA = vi.fn(
+      (_blob: Blob) =>
+        new Promise<boolean>(resolve => {
+          complete = resolve
+        })
+    )
+
+    const attachB = vi.fn(async () => true)
+    mount(attachA)
+    mount(attachB, { target: 'tile:b', surface: 'surface-b', session: 'b' })
+    const submit = vi.fn()
+    window.addEventListener('hermes:composer-submit', submit)
+
+    try {
+      let settled = false
+
+      const result = composerHost.attachImages('runtime-a', [png()]).then(ok => {
+        settled = true
+
+        return ok
+      })
+
+      expect(attachA).toHaveBeenCalledOnce()
+      expect(attachB).not.toHaveBeenCalled()
+      await Promise.resolve()
+      expect(settled).toBe(false)
+      act(() => markActiveComposer('tile:b'))
+      await act(async () => complete(true))
+      expect(await result).toBe(true)
+      expect(submit).not.toHaveBeenCalled()
+      expect(attachA.mock.calls[0]![0]).toBeInstanceOf(Blob)
+    } finally {
+      window.removeEventListener('hermes:composer-submit', submit)
+    }
+  })
+
+  it.each([false, undefined, 'reject'])('does not report async ingestion failure as accepted (%s)', async outcome => {
+    const attach = vi.fn(async () => {
+      if (outcome === 'reject') {
+        throw new Error('native image save failed')
+      }
+
+      return outcome as boolean | undefined
+    })
+
+    mount(attach)
+    await expect(composerHost.attachImages('a', [png()])).resolves.toBe(false)
+  })
+
+  it('refuses absent, hidden and disabled surfaces before ingestion', async () => {
+    const attach = vi.fn(async () => true)
+    await expect(composerHost.attachImages('missing', [png()])).resolves.toBe(false)
+    const hidden = mount(attach, { visible: false })
+    await expect(composerHost.attachImages('a', [png()])).resolves.toBe(false)
+    hidden.unmount()
+    mount(attach, { disabled: true })
+    await expect(composerHost.attachImages('a', [png()])).resolves.toBe(false)
+    expect(attach).not.toHaveBeenCalled()
+  })
+
+  it('rejects a stale mounted session and same-named session on another connection/profile', async () => {
+    const attach = vi.fn(async () => true)
+    const stale = mount(attach, { session: 'b' })
+    await expect(composerHost.attachImages('a', [png()])).resolves.toBe(false)
+    stale.unmount()
+    mount(attach, { connectionId: 'remote', profile: 'different' })
+    await expect(composerHost.attachImages('a', [png()])).resolves.toBe(false)
+    expect(attach).not.toHaveBeenCalled()
+  })
+
+  it('refuses ambiguous session ownership instead of guessing one backend', async () => {
+    const attach = vi.fn(async () => true)
+    mount(attach)
+    $sessions.set([
+      { id: 'a', connection_id: 'local', profile: 'default' },
+      { id: 'a', connection_id: 'remote', profile: 'default' }
+    ] as never)
+    await expect(composerHost.attachImages('a', [png()])).resolves.toBe(false)
+    expect(attach).not.toHaveBeenCalled()
+  })
+
+  it.each(['session', 'connection', 'profile', 'owner-profile', 'selected-session', 'unmount'])(
+    'invalidates native save continuation across a %s round trip',
+    async change => {
+      let complete!: () => void
+      let guard!: () => boolean
+      const added: Blob[] = []
+
+      const attach = vi.fn((blob: Blob, isCurrent?: () => boolean) => {
+        guard = isCurrent!
+
+        return new Promise<boolean>(resolve => {
+          complete = () => {
+            if (isCurrent?.()) {
+              added.push(blob)
+            }
+
+            resolve(isCurrent?.() === true)
+          }
+        })
+      })
+
+      const hook = mount(attach)
+      const result = composerHost.attachImages('a', [png()])
+      expect(guard()).toBe(true)
+
+      if (change === 'session') {
+        hook.rerender({ sessionKey: 'b' })
+        hook.rerender({ sessionKey: 'a' })
+      } else if (change === 'connection') {
+        act(() => $connection.set({ connectionId: 'other', mode: 'remote' } as never))
+        act(() => $connection.set({ connectionId: 'local', mode: 'local' } as never))
+      } else if (change === 'profile') {
+        act(() => $activeGatewayRoute.set('other'))
+        act(() => $activeGatewayRoute.set('default'))
+      } else if (change === 'owner-profile') {
+        act(() => $activeGatewayProfile.set('other'))
+        act(() => $activeGatewayProfile.set('default'))
+      } else if (change === 'selected-session') {
+        act(() => $selectedStoredSessionId.set('b'))
+        act(() => $selectedStoredSessionId.set('a'))
+      } else {
+        hook.unmount()
+      }
+
+      expect(guard()).toBe(false)
+      await act(async () => complete())
+      expect(await result).toBe(false)
+      expect(added).toEqual([])
+    }
+  )
+
+  it('expires an unfinished native save and prevents its late continuation from adding a chip', async () => {
+    vi.useFakeTimers()
+    let complete!: () => void
+    let guard!: () => boolean
+
+    const attach = vi.fn(
+      (_blob: Blob, isCurrent?: () => boolean) =>
+        new Promise<boolean>(resolve => {
+          guard = isCurrent!
+          complete = () => resolve(isCurrent?.() === true)
+        })
+    )
+
+    mount(attach)
+    const result = composerHost.attachImages('a', [png()])
+    await act(async () => vi.advanceTimersByTimeAsync(30_000))
+    expect(await result).toBe(false)
+    expect(guard()).toBe(false)
+    await act(async () => complete())
+  })
+
+  it('enforces raster MIME, per-image/aggregate size and batch limits before ingestion', async () => {
+    const attach = vi.fn(async () => true)
+    mount(attach)
+    const max = new Blob([new Uint8Array(8 * 1024 * 1024)], { type: 'image/png' })
+
+    for (const blobs of [
+      [],
