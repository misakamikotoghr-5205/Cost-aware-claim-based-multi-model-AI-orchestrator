+const IMAGE_ATTACH_TIMEOUT_MS = 30_000
+const imageAttachReplies = new Map<number, (ok: boolean) => void>()
+let imageAttachToken = 0
+
+/** A narrow image draft boundary. SVG and unbounded image payloads are excluded. */
+export const validComposerImages = (blobs: Blob[]): boolean =>
+  Array.isArray(blobs) &&
+  blobs.length > 0 &&
+  blobs.length <= 4 &&
+  blobs.every(
+    blob =>
+      blob instanceof Blob &&
+      blob.size > 0 &&
+      blob.size <= 8 * 1024 * 1024 &&
+      ['image/png', 'image/jpeg', 'image/webp', 'image/gif'].includes(blob.type)
+  ) &&
+  blobs.reduce((total, blob) => total + blob.size, 0) <= 16 * 1024 * 1024
+
+/** Return true only after native image ingestion succeeds for the exact draft.
+ * Captures synchronously, unlike paste-to-focus: no later active pane can claim it. */
+export const requestComposerAttachImagesAcked = (
+  blobs: Blob[],
+  {
+    target = 'active',
+    ids = [],
+    owner,
+    isCurrent = () => true
+  }: {
+    target?: ComposerTarget | 'active'
+    ids?: string[]
+    owner?: { connectionId: string; profile: string }
+    isCurrent?: () => boolean
+  } = {}
+): Promise<boolean> => {
+  if (typeof window === 'undefined' || !validComposerImages(blobs)) {
+    return Promise.resolve(false)
+  }
+
+  const resolvedTarget = resolve(target)
+  const surfaceId = getVisibleComposerSurfaceId(resolvedTarget)
+
+  if (!surfaceId || !isCurrent()) {
+    return Promise.resolve(false)
+  }
+
+  const token = ++imageAttachToken
+
+  return new Promise<boolean>(resolveReply => {
+    const timeout = window.setTimeout(() => ackComposerAttachImages(token, false), IMAGE_ATTACH_TIMEOUT_MS)
+    imageAttachReplies.set(token, ok => {
+      window.clearTimeout(timeout)
+      resolveReply(ok)
+    })
+
+    const detail: AttachImagesDetail = {
+      blobs: [...blobs],
+      target: resolvedTarget,
+      surfaceId,
+      ids: [...ids],
+      owner,
+      token,
+      isCurrent: () =>
+        imageAttachReplies.has(token) && isCurrent() && getVisibleComposerSurfaceId(resolvedTarget) === surfaceId
+    }
+
+    dispatchNow(ATTACH_IMAGES_EVENT, detail)
+
+    if (!detail.claimed) {
+      ackComposerAttachImages(token, false)
+    }
+  })
+}
+
+/** Async ingestion acknowledgement, never an acknowledgement of prompt submission. */
+export const ackComposerAttachImages = (token: number | undefined, ok: boolean) => {
+  if (token === undefined) {
+    return
+  }
+
+  const reply = imageAttachReplies.get(token)
+  imageAttachReplies.delete(token)
+  reply?.(ok === true)
+}
+
 export const onComposerAttachImagesRequest = (handler: (detail: AttachImagesDetail) => void) =>
   subscribe<AttachImagesDetail>(ATTACH_IMAGES_EVENT, handler)
 
