+import { useStore } from '@nanostores/react'
+import { useLayoutEffect } from 'react'
+
+import { usePaneVisible } from '@/components/pane-shell/pane-visibility'
+import { freshDraftScope } from '@/store/composer'
+import { $activeGatewayRoute } from '@/store/gateway'
+import { $activeGatewayProfile, normalizeProfileKey } from '@/store/profile'
+import { $connection } from '@/store/session'
+
+import { ackComposerAttachImages, onComposerAttachImagesRequest } from '../focus'
+import { useComposerScope, useComposerSurfaceId } from '../scope'
+import type { ChatBarProps } from '../types'
+
+interface ImageRequestOptions {
+  sessionId?: string | null
+  sessionKey: string | null
+  inputDisabled: boolean
+  profile?: string | null
+  onAttachImageBlob: ChatBarProps['onAttachImageBlob']
+}
+
+/** The existing paste bus and SDK share one ingestion path, owned by this draft. */
+export function useComposerImageRequests({
+  sessionId,
+  sessionKey,
+  inputDisabled,
+  profile,
+  onAttachImageBlob
+}: ImageRequestOptions) {
+  const scope = useComposerScope()
+  const surfaceId = useComposerSurfaceId()
+  const visible = usePaneVisible()
+  const connection = useStore($connection)
+  const activeProfile = useStore($activeGatewayProfile)
+  const route = useStore($activeGatewayRoute)
+  const connectionId = scope.connectionId ?? connection?.connectionId ?? (connection?.mode === 'local' ? 'local' : '')
+  const ownerProfile = normalizeProfileKey(scope.profile ?? profile ?? activeProfile)
+
+  useLayoutEffect(() => {
+    if (!onAttachImageBlob) {
+      return
+    }
+
+    let mounted = true
+    let generation = 0
+
+    const offRoute = $activeGatewayRoute.listen(() => {
+      generation += 1
+    })
+
+    const offRequest = onComposerAttachImagesRequest(detail => {
+      if (detail.target !== scope.target) {
+        return
+      }
+
+      if (detail.token === undefined) {
+        for (const blob of detail.blobs) {
+          void onAttachImageBlob(blob)
+        }
+
+        return
+      }
+
+      const ids = [sessionId, sessionKey].filter((id): id is string => Boolean(id))
+
+      if (!ids.length) {
+        ids.push(freshDraftScope())
+      }
+
+      if (
+        generation !== 0 ||
+        detail.claimed ||
+        !visible ||
+        inputDisabled ||
+        detail.surfaceId !== surfaceId ||
+        (detail.owner && (detail.owner.connectionId !== connectionId || detail.owner.profile !== ownerProfile)) ||
+        (detail.ids?.length && !detail.ids.some(id => ids.includes(id))) ||
+        !detail.isCurrent?.()
+      ) {
+        return
+      }
+
+      detail.claimed = true
+      const capturedGeneration = generation
+      const isCurrent = () => mounted && generation === capturedGeneration && detail.isCurrent?.() === true
+
+      void (async () => {
+        let ok = false
+
+        try {
+          for (const blob of detail.blobs) {
+            if (!isCurrent() || (await onAttachImageBlob(blob, isCurrent)) !== true) {
+              return
+            }
+          }
+
+          ok = isCurrent()
+        } catch {
+          ok = false
+        } finally {
+          ackComposerAttachImages(detail.token, ok)
+        }
+      })()
+    })
+
+    return () => {
+      mounted = false
+      offRequest()
+      offRoute()
+    }
+  }, [
+    sessionId,
+    sessionKey,
+    inputDisabled,
+    onAttachImageBlob,
+    scope.target,
+    connectionId,
+    ownerProfile,
+    route,
+    surfaceId,
+    visible
+  ])
+}
