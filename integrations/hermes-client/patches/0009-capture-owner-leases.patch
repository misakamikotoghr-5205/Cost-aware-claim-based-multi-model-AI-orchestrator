+    win.hide.mockImplementation(() => { visible = false })
+    win.showInactive.mockImplementation(() => { visible = true })
+    const pending = invoke(event)
+    await vi.waitFor(() => expect(win.hide).toHaveBeenCalledOnce(), { interval: 1, timeout: 50 })
+    contents.emit('did-start-navigation', {}, 'file:///app/index.html', false, true)
+    expect(await pending).toEqual({ status: 'cancelled' })
+    await vi.advanceTimersByTimeAsync(120)
+    expect(native.getSources.mock.calls.map(([options]) => options.thumbnailSize.width)).toEqual([0])
+    expect(win.showInactive).toHaveBeenCalledOnce()
+    expect(visible).toBe(true)
+    dispose()
+  })
+
+  it('an older request finishing metadata cannot restore a newer request hidden window', async () => {
+    vi.useFakeTimers()
+    const { invoke, event, win, dispose } = setup()
+    let visible = true
+    vi.spyOn(win, 'isVisible').mockImplementation(() => visible)
+    win.hide.mockImplementation(() => { visible = false })
+    win.showInactive.mockImplementation(() => { visible = true })
+    let finishOldContext!: (result: { window: null; frontmost: null }) => void
+    let finishPixels!: (sources: unknown[]) => void
+    native.readContext.mockImplementationOnce(() => new Promise(resolve => { finishOldContext = resolve }))
+    native.getSources.mockResolvedValueOnce([{ id: 'screen:1:0', name: 'Screen 1' }])
+      .mockImplementationOnce(() => new Promise(resolve => { finishPixels = resolve }))
+    const older = invoke(event)
+    await vi.waitFor(() => expect(native.readContext).toHaveBeenCalledTimes(1), { interval: 1, timeout: 50 })
+    const newer = invoke(event)
+    await vi.waitFor(() => expect(win.hide).toHaveBeenCalledOnce(), { interval: 1, timeout: 50 })
+    await vi.advanceTimersByTimeAsync(120)
+    expect(native.getSources).toHaveBeenCalledTimes(2)
+    finishOldContext({ window: null, frontmost: null })
+    expect(await older).toMatchObject({ status: 'cancelled', message: 'A screen selection is already open.' })
+    expect(win.showInactive).not.toHaveBeenCalled()
+    expect(visible).toBe(false)
+    finishPixels([{ id: 'screen:1:0', name: 'Screen 1', thumbnail: image }])
+    expect(await newer).toMatchObject({ status: 'ok' })
+    expect(win.showInactive).toHaveBeenCalledOnce()
+    expect(visible).toBe(true)
+    dispose()
+  })
 })
