index 00000000..b40f2f42
--- /dev/null
+++ b/apps/desktop/electron/misaka-branding.ts
@@ -0,0 +1,12 @@
+/** MISAKA owns the desktop shell; the underlying Hermes runtime and provider protocols retain their IDs. */
+export const MISAKA_BRAND = Object.freeze({
+  name: 'MISAKA AGENT',
+  disableUpstreamUpdates: true,
+  repository: 'https://github.com/misakamikotoghr-5205/Cost-aware-claim-based-multi-model-AI-orchestrator'
+})
+
+export function misakaClientUpdateStatus() {
+  return { supported: false, reason: 'misaka-managed-build', channelSelectable: false,
+    message: 'MISAKA AGENT 开发构建由本项目发布；请从项目仓库安装更新，避免官方 Hermes 更新覆盖客户端。',
+    advice: MISAKA_BRAND.repository, fetchedAt: Date.now() }
+}
