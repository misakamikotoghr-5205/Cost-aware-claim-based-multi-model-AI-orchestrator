diff --git a/apps/desktop/electron/misaka-branding.test.ts b/apps/desktop/electron/misaka-branding.test.ts
new file mode 100644
index 00000000..d47dd4b0
--- /dev/null
+++ b/apps/desktop/electron/misaka-branding.test.ts
@@ -0,0 +1,19 @@
+import { createRequire } from 'node:module'
+
+import { expect, test } from 'vitest'
+
+import { MISAKA_BRAND, misakaClientUpdateStatus } from './misaka-branding'
+const require = createRequire(import.meta.url)
+test('MISAKA owns OS identity while preserving the working provider protocol', () => {
+  const packaging = require('../electron-builder.config.cjs')
+  const identity = require('../product-identity.cjs')
+  expect(identity.displayName).toBe('MISAKA AGENT')
+  expect(identity.appId).toMatch(/^app\.misaka\./)
+  expect(packaging.publish).toBeNull()
+  expect(packaging.mac.publish).toBeNull()
+  expect(packaging.protocols[0].schemes).toEqual(['hermes'])
+})
+test('a development fork cannot apply an upstream desktop update', () => {
+  expect(MISAKA_BRAND.disableUpstreamUpdates).toBe(true)
+  expect(misakaClientUpdateStatus()).toMatchObject({ supported: false, channelSelectable: false, reason: 'misaka-managed-build' })
+})
