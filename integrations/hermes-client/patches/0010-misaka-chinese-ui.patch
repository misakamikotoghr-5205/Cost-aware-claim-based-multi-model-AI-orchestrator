diff --git a/apps/desktop/src/i18n/misaka-chinese.test.tsx b/apps/desktop/src/i18n/misaka-chinese.test.tsx
new file mode 100644
index 00000000..5a1dc221
--- /dev/null
+++ b/apps/desktop/src/i18n/misaka-chinese.test.tsx
@@ -0,0 +1,150 @@
+import { act, cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+
+import type { HermesConfigRecord } from '@/hermes'
+import { newSessionTitle, sessionTitle } from '@/lib/chat-runtime'
+import { reasoningEffortLabel } from '@/lib/reasoning-effort'
+
+import { type I18nConfigClient, I18nProvider, useI18n } from './context'
+import { en } from './en'
+import { setRuntimeI18nLocale } from './runtime'
+import { zhOverrides } from './zh'
+
+function Probe() {
+  const { locale, setLocale } = useI18n()
+
+  return (
+    <>
+      <span data-testid="locale">{locale}</span>
+      <button onClick={() => void setLocale('en')}>English</button>
+    </>
+  )
+}
+
+afterEach(() => {
+  cleanup()
+  vi.restoreAllMocks()
+  setRuntimeI18nLocale('zh')
+})
+
+it.each([{}, { display: { language: 'en', skin: 'slate' }, terminal: { cwd: '/project' } }])(
+  'persists Chinese once for a fresh or old English profile, then retains a manual English choice',
+  async initial => {
+    let config: HermesConfigRecord = structuredClone(initial)
+
+    const client: I18nConfigClient = {
+      getConfig: vi.fn(async () => structuredClone(config)),
+      saveConfig: vi.fn(async next => {
+        config = { ...config, ...structuredClone(next), display: { ...(config.display as object), ...(next.display as object) } }
+
+        return { ok: true }
+      })
+    }
+
+    const view = render(
+      <I18nProvider configClient={client} migrateToChinese>
+        <Probe />
+      </I18nProvider>
+    )
+
+    await waitFor(() => expect(config.display).toMatchObject({ language: 'zh', misaka_locale_version: 1 }))
+    expect(vi.mocked(client.saveConfig).mock.calls[0][0]).toEqual({ display: { language: 'zh', misaka_locale_version: 1 } })
+    expect(screen.getByTestId('locale').textContent).toBe('zh')
+
+    if ('terminal' in initial) {expect(config.terminal).toEqual(initial.terminal)}
+    fireEvent.click(screen.getByRole('button', { name: 'English' }))
+    await waitFor(() => expect(config.display).toMatchObject({ language: 'en', misaka_locale_version: 1 }))
+    view.unmount()
+    const saves = vi.mocked(client.saveConfig).mock.calls.length
+    render(
+      <I18nProvider configClient={client} migrateToChinese>
+        <Probe />
+      </I18nProvider>
+    )
+    await waitFor(() => expect(screen.getByTestId('locale').textContent).toBe('en'))
+    expect(client.saveConfig).toHaveBeenCalledTimes(saves)
+  }
+)
+
+it('serializes a manual choice after a pending rollout write', async () => {
+  let config: HermesConfigRecord = { display: { language: 'en' } }
+  let complete!: () => void
+
+  const client: I18nConfigClient = {
+    getConfig: vi.fn(async () => structuredClone(config)),
+    saveConfig: vi
+      .fn()
+      .mockImplementationOnce(
+        next =>
+          new Promise(resolve => {
+            complete = () => {
+              config = next
+              resolve({ ok: true })
+            }
+          })
+      )
+      .mockImplementation(async next => {
+        config = next
+
+        return { ok: true }
+      })
+  }
+
+  render(
+    <I18nProvider configClient={client} migrateToChinese>
+      <Probe />
+    </I18nProvider>
+  )
+  await waitFor(() => expect(complete).toBeTypeOf('function'))
+  fireEvent.click(screen.getByRole('button', { name: 'English' }))
+  await act(async () => complete())
+  await waitFor(() => expect(config.display).toMatchObject({ language: 'en', misaka_locale_version: 1 }))
+})
+
+function leaves(tree: unknown, path = ''): Array<[string, unknown]> {
+  if (tree && typeof tree === 'object' && !Array.isArray(tree)) {
+    return Object.entries(tree).flatMap(([key, value]) => leaves(value, path ? `${path}.${key}` : key))
+  }
+
+  return [[path, tree]]
+}
+
+describe('complete explicit Simplified Chinese catalog', () => {
+  const source = new Map(leaves(en).filter(([key]) => !key.startsWith('intro.')))
+  const translated = new Map(leaves(zhOverrides).filter(([key]) => !key.startsWith('intro.')))
+  it('does not silently fall back to English for any source leaf', () => {
+    expect([...source.keys()].filter(key => !translated.has(key))).toEqual([])
+
+    for (const [key, value] of source) {expect(typeof translated.get(key), key).toBe(typeof value)}
+  })
+  it('keeps parameterized text and function signatures intact', () => {
+    for (const [key, value] of source) {
+      if (typeof value !== 'function') {continue}
+      const target = translated.get(key) as (...args: unknown[]) => unknown
+      expect(target.length, key).toBe(value.length)
+      const args = Array.from({ length: value.length }, (_, i) => `⟦${i}⟧`)
+
+      try {
+        const from = JSON.stringify(value(...args))
+        const to = JSON.stringify(target(...args))
+
+        for (const arg of args.filter((arg, index) => from.includes(arg) && !(key === 'settings.toolsets.webCapabilitySelectedMessage' && index === 1))) {expect(to, key).toContain(arg)}
+      } catch (error) {
+        if (error instanceof TypeError) {continue} // structured input contract
+        throw error
+      }
+    }
+  })
+})
+
+it('localizes default titles and reasoning badges while preserving user titles and wire levels', () => {
+  setRuntimeI18nLocale('zh')
+  expect(newSessionTitle()).toBe('新建会话')
+  expect(reasoningEffortLabel('medium')).toBe('中')
+  expect(reasoningEffortLabel('ultra', 'max')).toBe('超强→最大')
+  expect(sessionTitle({ title: 'New session' } as never)).toBe('New session')
+  expect(sessionTitle({ title: '我的项目' } as never)).toBe('我的项目')
+  setRuntimeI18nLocale('en')
+  expect(newSessionTitle()).toBe('New session')
+  expect(reasoningEffortLabel('medium')).toBe('Med')
+})
