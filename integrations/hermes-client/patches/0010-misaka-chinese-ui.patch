diff --git a/apps/desktop/electron/misaka-native-menu.test.ts b/apps/desktop/electron/misaka-native-menu.test.ts
new file mode 100644
index 00000000..aff62d90
--- /dev/null
+++ b/apps/desktop/electron/misaka-native-menu.test.ts
@@ -0,0 +1,32 @@
+import { describe, expect, it, vi } from 'vitest'
+
+import { localizeMisakaMenu } from './misaka-native-menu'
+import { windowMenuTemplate } from './window-menu'
+
+describe('MISAKA Chinese native menus', () => {
+  it('localizes labels and role captions while preserving actions, accelerators and native menu semantics', () => {
+    const click = vi.fn()
+
+    const source = [
+      { label: 'File', submenu: [{ label: 'New Window', click, accelerator: 'Ctrl+N' }, { role: 'quit' as const }] }
+    ]
+
+    const menu = localizeMisakaMenu(source)
+    expect(menu[0].label).toBe('文件')
+    const submenu = menu[0].submenu as (typeof source)[0]['submenu']
+    expect(submenu[0]).toMatchObject({ label: '新建窗口', click, accelerator: 'Ctrl+N' })
+    expect(submenu[1]).toMatchObject({ label: '退出', role: 'quit' })
+    expect(source[0].label).toBe('File')
+  })
+
+  it('keeps standard Window role on macOS and the click-only Close behavior elsewhere', () => {
+    const mac = localizeMisakaMenu([windowMenuTemplate(true)])[0]
+    expect(mac).toMatchObject({ label: '窗口', role: 'windowMenu' })
+    const other = localizeMisakaMenu([windowMenuTemplate(false)])[0]
+    expect(other.submenu).toEqual(
+      expect.arrayContaining([
+        expect.objectContaining({ label: '关闭', registerAccelerator: false, click: expect.any(Function) })
+      ])
+    )
+  })
+})
