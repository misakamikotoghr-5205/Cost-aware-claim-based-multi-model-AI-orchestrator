+import { getRuntimeI18nLocale } from './runtime'
+
+/** Explicit copy for formerly hard-coded UI strings. No user content is passed
+ * here. Other languages retain the original copy until their catalog adds it. */
+export function misakaUiText(english: string, chinese: string): string {
+  return getRuntimeI18nLocale() === 'zh' ? chinese : english
+}
