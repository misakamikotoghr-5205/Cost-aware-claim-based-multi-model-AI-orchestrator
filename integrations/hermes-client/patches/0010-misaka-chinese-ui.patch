+  Help: '帮助'
+}
+
+const roles: Readonly<Record<string, string>> = {
+  services: '服务',
+  hide: '隐藏 MISAKA AGENT',
+  hideOthers: '隐藏其他应用',
+  unhide: '显示全部',
+  quit: '退出',
+  undo: '撤销',
+  redo: '重做',
+  cut: '剪切',
+  copy: '复制',
+  paste: '粘贴',
+  pasteAndMatchStyle: '粘贴并匹配样式',
+  delete: '删除',
+  selectAll: '全选',
+  showSubstitutions: '显示文本替换',
+  toggleTextReplacement: '启用文本替换',
+  forceReload: '强制重新加载',
+  togglefullscreen: '切换全屏',
+  minimize: '最小化',
+  zoom: '缩放',
+  front: '前置所有窗口'
+}
+
+/** Localize only our native menu template, preserving Electron actions and roles. */
+export function localizeMisakaMenu(template: MenuItemConstructorOptions[]): MenuItemConstructorOptions[] {
+  return template.map(item => ({
+    ...item,
+    ...(item.label?.startsWith('About MISAKA AGENT')
+      ? { label: '关于 MISAKA AGENT' }
+      : labels[item.label ?? ''] || roles[item.role ?? '']
+        ? { label: labels[item.label ?? ''] ?? roles[item.role ?? ''] }
+        : {}),
+    ...(Array.isArray(item.submenu) ? { submenu: localizeMisakaMenu(item.submenu) } : {})
+  }))
+}
