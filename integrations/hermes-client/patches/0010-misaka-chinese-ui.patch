+import { cleanup, fireEvent, render, screen, waitFor } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+
+import { I18nProvider, useI18n } from '@/i18n'
+
+import { useComposerPlaceholder } from './use-composer-placeholder'
+
+function Probe({ sessionId }: { sessionId: null | string }) {
+  const { setLocale } = useI18n()
+  const text = useComposerPlaceholder({ disabled: false, reconnecting: false, sessionId })
+
+  return (
+    <>
+      <span data-testid="placeholder">{text}</span>
+      <button onClick={() => void setLocale('zh')}>中文</button>
+    </>
+  )
+}
+
+afterEach(() => {
+  cleanup()
+  vi.restoreAllMocks()
+})
+
+it('updates an existing draft placeholder when its language changes without changing conversations', async () => {
+  vi.spyOn(Math, 'random').mockReturnValue(0.2)
+  render(
+    <I18nProvider configClient={null} initialLocale="en">
+      <Probe sessionId={null} />
+    </I18nProvider>
+  )
+  expect(screen.getByTestId('placeholder').textContent).toBe('Give MISAKA AGENT a task')
+  fireEvent.click(screen.getByRole('button', { name: '中文' }))
+  await waitFor(() => expect(screen.getByTestId('placeholder').textContent).toBe('给 MISAKA AGENT 一个任务'))
+})
+
+it('keeps the selected starter when its newly sent conversation receives an id', () => {
+  const random = vi.spyOn(Math, 'random').mockReturnValue(0.2)
+
+  const view = render(
+    <I18nProvider configClient={null} initialLocale="zh">
+      <Probe sessionId={null} />
+    </I18nProvider>
+  )
+
+  const starter = screen.getByTestId('placeholder').textContent
+  random.mockReturnValue(0.9)
+  view.rerender(
+    <I18nProvider configClient={null} initialLocale="zh">
+      <Probe sessionId="actual-session-id" />
+    </I18nProvider>
+  )
+  expect(screen.getByTestId('placeholder').textContent).toBe(starter)
+})
